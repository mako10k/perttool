{
  "name": "perttool-vscode-private",
  "displayName": "perttool (Private)",
  "description": "Private read-only VS Code language client for perttool",
  "version": "0.0.0",
  "private": true,
  "publisher": "perttool-private",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mako10k/perttool.git"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.101.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:pert",
    "onCommand:perttool.openHelp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pert",
        "aliases": [
          "PERT",
          "pert"
        ],
        "extensions": [
          ".pert"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pert",
        "scopeName": "source.pert",
        "path": "./syntaxes/pert.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "perttool.openHelp",
        "title": "perttool: Open Diagnostic Help",
        "enablement": "editorLangId == pert"
      }
    ]
  },
  "files": [
    "dist",
    "syntaxes",
    "language-configuration.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:list": "vsce ls --no-dependencies",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.9",
    "perttool": "file:../..",
    "perttool-language-server-private": "file:../lsp",
    "vscode-languageclient": "9.0.1"
  }
}
