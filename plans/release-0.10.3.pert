# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_0103:
  version 6
  title "perttool 0.10.3 canonical velocity token patch release"
  description "Release the accepted Issue #7 correction as suffix-free 0.10.3 while preserving Grammar 8, CLI Contract 9, public identities, source preservation, and automatic-adoption boundaries. npm latest, public VSIX publication, plan advance, and unrelated work remain separate."
  as_of 2026-08-21
  duration_unit point
  finish RELEASE_0103_ACCEPTED

milestone RELEASE_0103_STARTED:
  title "Version 0.10.3 release started"
  state reached

milestone RELEASE_0103_PREPARED:
  title "Version 0.10.3 source and candidate prepared"
  state reached

milestone RELEASE_0103_PUBLISHED:
  title "Version 0.10.3 published"
  state reached

milestone RELEASE_0103_ACCEPTED:
  title "Version 0.10.3 accepted"
  state reached

resource RELEASE_ENGINEERS:
  title "Release engineering capacity"
  capacity 1

task RELEASE_0103_PREPARATION RELEASE_0103_STARTED -> RELEASE_0103_PREPARED:
  title "Prepare and freeze version 0.10.3"
  description "Align version-bearing surfaces, pass complete local and installed gates, prove external identities unused, and retain one immutable candidate."
  duration 5p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
  source "Issue #7"

task RELEASE_0103_PUBLISH RELEASE_0103_PREPARED -> RELEASE_0103_PUBLISHED:
  title "Publish version 0.10.3"
  description "Push the exact commit and tag, require CI, create the GitHub prerelease, and publish the identical tarball once to npm beta."
  duration 3p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
  source "Issue #7"

task RELEASE_0103_ACCEPTANCE RELEASE_0103_PUBLISHED -> RELEASE_0103_ACCEPTED:
  title "Accept and close version 0.10.3"
  description "Read back Git, CI, GitHub, npm, artifact, installation, Issue #7 behavior, rollback, and close Issue #7 with evidence."
  duration 3p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
  source "Issue #7"
