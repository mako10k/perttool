# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_071:
  version 6
  title "perttool 0.7.1 Help and Guide consistency patch release"
  description "Release suffix-free 0.7.1 beta as a backward-compatible Grammar 6 and CLI Contract 7 patch for GUIDE-CONSISTENCY-001. Publish exact active Guide meaning, argument-valid Help examples, resolvable diagnostic navigation, PTCNV-210 coverage, and current-versus-historical documentation labels without changing commands, options, result or schema identities, payload structure, or authority. External publication, npm latest promotion, plan advance, and Issue mutation remain separately gated."
  as_of 2026-08-05
  duration_unit point
  velocity 15p/1d
  finish RELEASE_071_ACCEPTED
  goal_owner user
  dag_owner user

milestone RELEASE_071_PLANNING_STARTED:
  title "Version 0.7.1 release planning started"
  state reached

resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub prerelease, npm beta publication, and durable verification."
  capacity 1

milestone RELEASE_071_REVIEW_ACCEPTED:
  title "Version 0.7.1 compatibility review accepted"

milestone RELEASE_071_SOURCE_PREPARED:
  title "Version 0.7.1 release source prepared"

milestone RELEASE_071_CANDIDATE_ACCEPTED:
  title "Version 0.7.1 release candidate accepted"

milestone RELEASE_071_PUBLISHED:
  title "Version 0.7.1 published to GitHub and npm beta"

milestone RELEASE_071_ACCEPTED:
  title "Version 0.7.1 Help and Guide patch accepted"

task RELEASE_071_SELF_REVIEW RELEASE_071_PLANNING_STARTED -> RELEASE_071_REVIEW_ACCEPTED:
  title "Review the 0.7.1 compatibility and release boundary"
  description "Confirm the accepted GUIDE-CONSISTENCY-001 input, select patch version 0.7.1, prove unchanged Grammar 6, CLI Contract 7, command, option, result, schema, payload-structure, package-root, and authority identities, fix requirements, ADR, procedure, plan, and tests, and record why a no-release update or 0.8.0 would misstate the boundary. This task performs no external write."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
  source "GUIDE-CONSISTENCY-001"

task RELEASE_071_PREPARATION RELEASE_071_REVIEW_ACCEPTED -> RELEASE_071_SOURCE_PREPARED:
  title "Prepare version 0.7.1 release source"
  description "Align package and lockfile identity, CLI version, CHANGELOG, README, release documentation, tests, goldens, self-use registration, dependency audit, and beta publication validation. Run the complete Node.js 22 repository and package gates without remote or registry writes."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
  source "GUIDE-CONSISTENCY-001"

task RELEASE_071_CANDIDATE RELEASE_071_SOURCE_PREPARED -> RELEASE_071_CANDIDATE_ACCEPTED:
  title "Accept one clean 0.7.1 release candidate"
  description "Review and commit the complete release diff; repeat Node.js 22 acceptance; prove package, tag, GitHub Release, and npm version availability; verify beta=latest=0.7.0 and no alpha; verify protected routes; build one immutable tarball outside the worktree; and accept its timestamp, sizes, file count, digests, and installed Contract 7 behavior. This task performs no external write."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
  source "GUIDE-CONSISTENCY-001"

task RELEASE_071_PUBLISH RELEASE_071_CANDIDATE_ACCEPTED -> RELEASE_071_PUBLISHED:
  title "Publish version 0.7.1 from one immutable tarball"
  description "Only after every predecessor gate passes and the user separately authorizes the exact candidate and external batch, push and verify the clean release commit and annotated tag, wait for Node.js 22 and 24 CI, publish the GitHub prerelease and SHA256SUMS, install its asset, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.7.1 while latest remains 0.7.0."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1
  source "GUIDE-CONSISTENCY-001"

task RELEASE_071_ACCEPTANCE RELEASE_071_PUBLISHED -> RELEASE_071_ACCEPTED:
  title "Record durable 0.7.1 beta acceptance"
  description "Independently verify release commit and peeled tag identity, successful CI, common candidate, GitHub, and npm tarball bytes, registry integrity and metadata, exact and beta isolated installation, corrected Guide and Help behavior, diagnostics, compatibility, and rollback pin. Record evidence without changing latest, advancing a plan, or mutating an Issue."
  duration 2p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
  source "GUIDE-CONSISTENCY-001"
