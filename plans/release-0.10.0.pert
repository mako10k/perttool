# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_0100:
  version 8
  title "perttool 0.10.0 temporal scheduling beta release"
  description "Release suffix-free 0.10.0 beta as the first Grammar 8 and CLI Contract 9 public boundary after 0.9.4. Publish accepted calendar-aware temporal scheduling, availability and event constraints, forward and required schedules, POSTDUE projections, source-preserving mutation, replacement result schemas, and compatible read-only adapter behavior. Keep private LSP, VSIX, and MCP workspaces excluded from the public npm package. Candidate acceptance, PUBLISH, durable acceptance, npm latest promotion, plan advance, public VSIX publication, and Issue mutation remain separately gated."
  as_of 2026-08-18T13:15:00+09:00
  duration_unit point
  velocity 29p/2d
  finish RELEASE_0100_ACCEPTED
  goal_owner user
  dag_owner user

milestone RELEASE_0100_PLANNING_STARTED:
  title "Version 0.10.0 release planning started"
  state reached

resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize scope, compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, migration guidance, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub prerelease, npm beta publication, and durable verification."
  capacity 1

milestone RELEASE_0100_GATE_ACCEPTED:
  title "Version 0.10.0 release gate accepted"

milestone RELEASE_0100_INPUTS_READY:
  title "Accepted 0.10.0 release inputs verified"

milestone RELEASE_0100_SOURCE_PREPARED:
  title "Version 0.10.0 release source prepared"

milestone RELEASE_0100_CANDIDATE_ACCEPTED:
  title "Version 0.10.0 release candidate accepted"

milestone RELEASE_0100_PUBLISHED:
  title "Version 0.10.0 published to GitHub and npm beta"

milestone RELEASE_0100_ACCEPTED:
  title "Version 0.10.0 temporal scheduling beta accepted"

task RELEASE_0100_GATE_DESIGN RELEASE_0100_PLANNING_STARTED -> RELEASE_0100_GATE_ACCEPTED:
  title "Define the 0.10.0 Grammar 8 and Contract 9 release gate"
  description "Select suffix-free 0.10.0 for the breaking public boundary after 0.9.4. Bind the accepted temporal scheduling and Contract 9 inputs; verify the 53-to-56 command boundary, retained 23-schema count with seven replacement roots, unchanged 129 root and Node exports and 45 Core exports, migration, authority, compatibility, and private-adapter exclusions; and align requirements, ADR, design, procedure, plan metadata, and focused tests. This task performs no external write."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

task RELEASE_0100_INPUT_READINESS RELEASE_0100_GATE_ACCEPTED -> RELEASE_0100_INPUTS_READY:
  title "Verify accepted 0.10.0 release inputs"
  description "Require the completed TEMPORAL-SCHEDULE-001 parent plan, the completed TEMPORAL_PUBLIC_CONTRACT_DETAIL plan, and their accepted cross-surface records. Verify Grammar 8, CLI Contract 9, calendar and availability maintenance, event constraints, forward and required schedules, POSTDUE, replacement results and schemas, adapters, compatibility, package exclusions, and no-write boundaries without duplicating implementation state. This task performs no external write."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

task RELEASE_0100_PREPARATION RELEASE_0100_INPUTS_READY -> RELEASE_0100_SOURCE_PREPARED:
  title "Prepare version 0.10.0 release source"
  description "Align package and lockfile identity, CLI and adapter peer versions, MCP identity, CHANGELOG, README, 0.9.4-to-0.10.0 migration guidance, release documentation, tests, goldens, self-use registration, dependency and package inventory audits, and beta publication validation. Run the complete Node.js 22 repository and installed-package gates without remote or registry writes."
  duration 5p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

task RELEASE_0100_CANDIDATE RELEASE_0100_SOURCE_PREPARED -> RELEASE_0100_CANDIDATE_ACCEPTED:
  title "Accept one clean 0.10.0 release candidate"
  description "Review and commit the complete release diff; repeat Node.js 22 acceptance; prove package, tag, GitHub Release, and npm version availability; read back beta and latest without changing them; verify authenticated routes; retain one immutable tarball outside the worktree; and accept its source commit, timestamp, sizes, file count, digests, public inventory, installed Contract 9 behavior, compatibility, and rollback pin. This task performs no external write."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1

task RELEASE_0100_PUBLISH RELEASE_0100_CANDIDATE_ACCEPTED -> RELEASE_0100_PUBLISHED:
  title "Publish version 0.10.0 from one immutable tarball"
  description "Only after every predecessor gate passes and the user separately authorizes the exact candidate and external batch, push and verify the clean release commit and annotated tag, require Node.js 22 and 24 CI, publish one GitHub prerelease and SHA256SUMS, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.10.0 while latest remains unchanged. Do not publish the private VSIX, LSP, or MCP adapters."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1

task RELEASE_0100_ACCEPTANCE RELEASE_0100_PUBLISHED -> RELEASE_0100_ACCEPTED:
  title "Record durable 0.10.0 beta acceptance"
  description "Independently verify release commit and peeled tag identity, successful CI, common candidate, GitHub and npm tarball bytes, registry integrity and metadata, exact and beta isolated installation, Grammar 1 through 8 compatibility, Contract 9 commands and schemas, temporal behavior, package facades, private-adapter exclusion, and the exact 0.9.4 rollback pin. Record evidence without changing npm latest, publishing a VSIX, advancing a plan, or mutating an Issue."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

