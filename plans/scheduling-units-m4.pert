project SCHEDULING_UNITS_M4:
  version 1
  title "SU-M4 exact unit-migration target Core"
  description "Implement and accept only the internal unit-migration version 2 Core selected by the scheduling-and-units macro. SU-M2R exact Decimal-or-fraction Duration, canonical serialization, target Grammar 3, and version-boundary capabilities are accepted inputs. The active Grammar 1 runtime, CLI Contract 3, public schemas, root exports, command registry, help, Guide, installed workflow, Next v3 authority, and package distribution remain unchanged. The initial velocity is inherited at 24p/1d; six tasks total 25p."
  as_of 2026-07-25
  duration_unit point
  velocity 21p/1d
  finish UNIT_MIGRATION_ACCEPTED


resource DEVELOPERS:
  title "Implementation capacity"
  description "Two independent target-only slices may run together when ownership does not overlap"
  capacity 2

resource REVIEWERS:
  title "Migration contract and compatibility review capacity"
  capacity 1

resource MIGRATION_CORE_SURFACE:
  title "Unit-migration algorithm and integration ownership"
  description "Serialize request, conversion, candidate, result, reversibility, and acceptance changes in the migration Core"
  capacity 1

resource TARGET_SOURCE_SURFACE:
  title "Grammar 1, 2, and 3 target source-candidate ownership"
  capacity 1

resource TARGET_RESULT_SURFACE:
  title "Internal UnitMigrationResult v2 projection ownership"
  capacity 1

resource SAFE_WRITE_SURFACE:
  title "Candidate diff, digest, and target safe-write ownership"
  capacity 1

resource CONTRACT3_GUARD:
  title "Active Grammar 1 and CLI Contract 3 compatibility gate"
  capacity 1






milestone M4_ACCEPTANCE_INPUT_READY:
  title "SU-M4 migration branches ready for acceptance"
  state reached

milestone UNIT_MIGRATION_ACCEPTED:
  title "SU-M4 exact unit-migration Core accepted"








task M4_UNIT_MIGRATION_ACCEPTANCE M4_ACCEPTANCE_INPUT_READY -> UNIT_MIGRATION_ACCEPTED:
  title "Accept the SU-M4 unit-migration target Core"
  description "Trace every SU-M4-owned TUI and TUE observation through unit, malformed-input, property, source-preservation, safe-write, no-op, repetition, inverse, and deterministic-result tests. Verify active Grammar 1, CLI Contract 3, public schemas, root exports, the 27-command registry, help, Guide, Next v3 authority, and installed behavior remain unchanged and reject the target operation. Record the SU-M5 handoff and run the full repository, documentation, self-use, link, and package gates without activating Contract 4 or publishing anything."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    MIGRATION_CORE_SURFACE 1
    TARGET_SOURCE_SURFACE 1
    TARGET_RESULT_SURFACE 1
    SAFE_WRITE_SURFACE 1
    CONTRACT3_GUARD 1
