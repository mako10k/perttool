# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_055:
  version 5
  title "perttool 0.5.5 governed-preview warning patch release"
  description "Release suffix-free 0.5.5 beta as a backward-compatible Grammar 5 and CLI Contract 6 patch. Publish PTGOV-104 runtime visibility when an applicable preview already carries an owner-confirmation assertion without changing the candidate, decision, persistent authority, command, option, result, schema, or runtime payload identities. npm latest promotion remains a separate decision."
  as_of 2026-07-30
  duration_unit point
  velocity 15p/1d
  finish RELEASE_055_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub prerelease, npm beta publication, and durable verification."
  capacity 1





milestone RELEASE_055_ACCEPTED:
  title "Version 0.5.5 governed-preview warning patch accepted"
  state reached
