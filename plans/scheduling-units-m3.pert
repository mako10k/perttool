project SCHEDULING_UNITS_M3:
  version 1
  title "SU-M3 temporal deadline and Next v4 target Core"
  description "Implement and accept only the internal SU-M3 temporal deadline and NextResult v4 target Core selected by the scheduling-and-units macro. Accepted Grammar 3 Duration, declared calendar values, temporal semantics, and Contract 4 interface requirements are inputs. Exact temporal inputs, both release-aware schedules, and deadline evaluation are complete; target result composition and acceptance total 6p at an observed 17p/1d velocity. Active Grammar 1, CLI Contract 3, public result schemas, root exports, registry/help, Guide, installed behavior, Next v3 normal authority, and package distribution remain unchanged until SU-M5."
  as_of 2026-07-25
  duration_unit point
  velocity 17p/1d
  finish DEADLINE_CAPABILITIES_ACCEPTED


resource DEVELOPERS:
  title "Implementation capacity"
  description "Two independent analysis branches may run together when ownership does not overlap."
  capacity 2

resource REVIEWERS:
  title "Temporal contract and compatibility review capacity"
  capacity 1

resource TEMPORAL_INPUT_SURFACE:
  title "Declared calendar projection ownership"
  capacity 1

resource PRECEDENCE_SURFACE:
  title "Temporal precedence analysis ownership"
  capacity 1

resource RESOURCE_SCHEDULE_SURFACE:
  title "Temporal heuristic resource-schedule ownership"
  capacity 1

resource DEADLINE_SURFACE:
  title "Deadline evaluation ownership"
  capacity 1

resource TARGET_RESULT_SURFACE:
  title "Internal AnalysisResult v3 and NextResult v4 ownership"
  capacity 1

resource CONTRACT3_GUARD:
  title "Active Grammar 1, CLI Contract 3, and Next v3 compatibility gate"
  capacity 1




milestone TEMPORAL_SCHEDULES_READY:
  title "Temporal schedule branches ready for deadline evaluation"
  state reached

milestone DEADLINE_EVALUATION_READY:
  title "Exact deadline evaluation ready"

milestone M3_ACCEPTANCE_INPUT_READY:
  title "Internal AnalysisResult v3 and NextResult v4 ready"

milestone DEADLINE_CAPABILITIES_ACCEPTED:
  title "SU-M3 temporal deadline and Next v4 target Core accepted"






task DEADLINE_EVALUATION_CORE TEMPORAL_SCHEDULES_READY -> DEADLINE_EVALUATION_READY:
  title "Evaluate exact deadline state and risk"
  description "Implement milestone and task deadline relationships, current due and overdue state, exact margin and lateness, precedence/resource feasibility, blocked and heuristic qualification, risk, and deterministic diagnostic causes from the accepted temporal schedules."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    DEADLINE_SURFACE 1
    CONTRACT3_GUARD 1

task ANALYSIS_NEXT_V4_TARGET DEADLINE_EVALUATION_READY -> M3_ACCEPTANCE_INPUT_READY:
  title "Compose internal AnalysisResult v3 and NextResult v4"
  description "Project complete target-only AnalysisResult v3 and NextResult v4 values. Embed the unchanged complete NextResult v3 recommendation graph, add only the normative temporal release gate and deadline evidence, preserve versioned identities and deterministic JSON-ready records, and add no public adapter or normal-authority switch."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    TARGET_RESULT_SURFACE 1
    CONTRACT3_GUARD 1

task M3_DEADLINE_ACCEPTANCE M3_ACCEPTANCE_INPUT_READY -> DEADLINE_CAPABILITIES_ACCEPTED:
  title "Accept the SU-M3 temporal deadline target Core"
  description "Trace SU-M3-owned TUI and TUE observations through exact calendar, release, temporal schedule, deadline, malformed-input, blocked, deterministic-result, and authority-boundary tests. Verify active Grammar 1, CLI Contract 3, AnalysisResult v2, NextResult v3 normal authority, root exports, registry/help, Guide, installed behavior, and package distribution remain unchanged. Record the SU-M5 handoff and run the full repository gates."
  duration 2p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    TEMPORAL_INPUT_SURFACE 1
    PRECEDENCE_SURFACE 1
    RESOURCE_SCHEDULE_SURFACE 1
    DEADLINE_SURFACE 1
    TARGET_RESULT_SURFACE 1
    CONTRACT3_GUARD 1
