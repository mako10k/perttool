# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_040:
  version 4
  title "perttool 0.4.0 Contract 5 beta release"
  description "Release suffix-free 0.4.0 beta from the accepted atomic Contract 5 source and one verified tarball. RELEASE_040_GATE_DESIGN, RELEASE_040_CONTRACT_5_READINESS, and RELEASE_040_PREPARATION are complete. Governance acceptance and readiness verified the complete public, owner-aware safe-write, and installed-package boundary; the prepared 0.4.0 source, Contract 4-to-5 migration guidance, tests, goldens, and package identity passed the full Node.js 22 repository and isolated-package gates. Three tasks and 10p remain; precedence and heuristic resource makespans are both 10p with an inherited 20/19d forecast. Complete NextResult v4 recommends RELEASE_040_CANDIDATE. Current authorization stops after source preparation. RELEASE_040_PUBLISH remains blocked pending separate explicit authorization for the named 0.4.0 external batch; npm latest promotion and Issue #4 closure remain separate post-acceptance decisions."
  as_of 2026-07-28
  duration_unit point
  velocity 19p/2d
  finish RELEASE_040_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize scope, contract, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, migration guidance, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1


milestone RELEASE_040_CONTRACT_5_READY:
  title "Accepted Contract 5 release input verified"
  state reached

milestone RELEASE_040_SOURCE_PREPARED:
  title "Version 0.4.0 release source prepared"

milestone RELEASE_040_CANDIDATE_ACCEPTED:
  title "Version 0.4.0 release candidate accepted"

milestone RELEASE_040_PUBLISHED:
  title "Version 0.4.0 published to GitHub and npm beta"

milestone RELEASE_040_ACCEPTED:
  title "Version 0.4.0 Contract 5 beta accepted"



task RELEASE_040_PREPARATION RELEASE_040_CONTRACT_5_READY -> RELEASE_040_SOURCE_PREPARED:
  title "Prepare version 0.4.0 release source"
  description "Align package and lockfile identity, CLI version, CHANGELOG, README, Contract 4-to-5 migration guidance, release documentation, tests, goldens, and beta publication validation. Run the complete repository and package gates without remote or registry writes."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

task RELEASE_040_CANDIDATE RELEASE_040_SOURCE_PREPARED -> RELEASE_040_CANDIDATE_ACCEPTED:
  title "Accept one clean 0.4.0 release candidate"
  description "Review and commit the complete release diff; run Node.js 22 acceptance; prove package, tag, and GitHub Release availability; verify npm baselines and protected routes; build one immutable tarball outside the worktree; and accept its digest. This task performs no external write."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1

task RELEASE_040_PUBLISH RELEASE_040_CANDIDATE_ACCEPTED -> RELEASE_040_PUBLISHED:
  title "Publish version 0.4.0 from one immutable tarball"
  description "Only under separate explicit authorization for the named 0.4.0 batch, push and verify the clean release commit and annotated tag, publish the GitHub prerelease and SHA256SUMS, install its asset, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.4.0 while latest remains unchanged."
  duration 3p
  status blocked
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1
  blocked_reason "Await separate explicit user authorization for the named 0.4.0 external publication batch after all preceding gates pass."

task RELEASE_040_ACCEPTANCE RELEASE_040_PUBLISHED -> RELEASE_040_ACCEPTED:
  title "Record durable 0.4.0 beta acceptance"
  description "Verify release commit and peeled tag identity, common candidate/GitHub/npm tarball digest, registry integrity and metadata, isolated installation from both public channels, complete Contract 5 behavior, beta and unchanged latest tags, and exact commands. Record acceptance without altering the immutable artifact or closing Issue #4."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
