# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project POOL_RELEASE_READINESS:
  version 6
  title "Planning Pool release readiness and next minor"
  description "Resolve and accept every Planning Pool pre-release review issue under Issue #12, close P0 before P1 and P2, verify human and machine contracts, and prepare and publish the next minor only through separately authorized release gates. Issue #24 Goal Coverage and Goal Seal implementation, npm latest promotion, public VSIX publication, Issue closure, plan advance, and unrelated work remain separate."
  as_of 2026-08-26
  duration_unit point
  finish POOL_RELEASE_ACCEPTED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1

milestone POOL_RELEASE_REVIEW_STARTED:
  title "Planning Pool release review started"
  state reached

resource ADVANCE_ENGINEERS:
  title "Advance correction capacity"
  description "Own terminal candidate normalization and post-Advance lifecycle tests."
  capacity 1

resource CLI_ENGINEERS:
  title "Planning Pool CLI implementation capacity"
  description "Own Contract 10 discovery, usage, text rendering, and intent-oriented commands."
  capacity 2

resource DOC_REVIEWERS:
  title "Human guidance review capacity"
  description "Own Guide, examples, onboarding, release notes, and nontechnical meaning review."
  capacity 1

resource SCHEMA_ENGINEERS:
  title "Request and result schema capacity"
  description "Own standalone request schemas, catalog identity, and installed validation."
  capacity 1

resource ACCEPTANCE_REVIEWERS:
  title "Cross-surface acceptance capacity"
  description "Own independent exact-source, installed-package, and regression review."
  capacity 1

resource RELEASE_ENGINEERS:
  title "Release engineering capacity"
  description "Own version selection, immutable candidate, publication, and durable readback."
  capacity 1

milestone POOL_ADVANCE_CORRECTED:
  title "Advance terminal candidate corrected"

milestone POOL_P0_READY:
  title "All Planning Pool P0 blockers accepted"

milestone POOL_GRAMMAR9_GUIDE_READY:
  title "Grammar 9 Guide correction accepted"

milestone POOL_HUMAN_TEXT_READY:
  title "Planning Pool human text UI accepted"

milestone POOL_INTENT_UI_READY:
  title "Intent-oriented Planning Pool UI accepted"

milestone POOL_REQUEST_SCHEMA_READY:
  title "Planning Pool request schemas accepted"

milestone POOL_GOAL_BOUNDARY_READY:
  title "Final Goal non-guarantee guidance accepted"

milestone POOL_P1_READY:
  title "All Planning Pool P1 corrections accepted"

milestone POOL_COMPOUND_HELP_READY:
  title "Natural compound Help lookup accepted"

milestone POOL_ENTITY_INSPECTION_READY:
  title "Planning Event and Activity inspection accepted"

milestone POOL_P2_READY:
  title "All Planning Pool P2 corrections accepted"

milestone POOL_INTEGRATED:
  title "Planning Pool release surface integrated and accepted"

milestone POOL_RELEASE_GATE_ACCEPTED:
  title "Next-minor release gate accepted"

milestone POOL_RELEASE_PREPARED:
  title "Next-minor release source prepared"

milestone POOL_RELEASE_CANDIDATE_ACCEPTED:
  title "Immutable next-minor candidate accepted"

milestone POOL_RELEASE_PUBLISHED:
  title "Next Planning Pool minor published"

milestone POOL_RELEASE_ACCEPTED:
  title "Next Planning Pool minor durably accepted"

task POOL_ADVANCE_EOF_FIX POOL_RELEASE_REVIEW_STARTED -> POOL_ADVANCE_CORRECTED:
  title "Correct Advance terminal candidate normalization"
  description "Resolve Issue #25 with a retained final-milestone evidence fixture, exact terminal-byte ownership, preview/out/write identity, and git diff --check acceptance."
  duration 5p
  status done
  priority 100
  requires:
    ADVANCE_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #25"

task POOL_POST_ADVANCE_TEST_FIX POOL_ADVANCE_CORRECTED -> POOL_P0_READY:
  title "Make Planning Pool acceptance tests survive canonical Advance"
  description "Resolve Issue #28 by separating immutable pre-Advance evidence from the canonical residual plan without restoring removed declarations."
  duration 3p
  status done
  priority 100
  requires:
    ADVANCE_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #28"

task POOL_WINDOW_OPTION_CONTRACT POOL_RELEASE_REVIEW_STARTED -> POOL_P0_READY:
  title "Reject inapplicable Planning Pool mutation options"
  description "Resolve Issue #26 with Planning Pool-specific option groups, exit-2 rejection, exact Help and usage discovery, and candidate noninterference tests."
  duration 3p
  status done
  priority 100
  requires:
    CLI_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #26"

task POOL_GRAMMAR9_GUIDE POOL_P0_READY -> POOL_GRAMMAR9_GUIDE_READY:
  title "Align the active syntax and Planning Pool Guide with Grammar 9"
  description "Resolve Issue #27 across syntax summaries, additive Grammar 8 and 9 declarations, reciprocal navigation, tests, and goldens."
  duration 3p
  status done
  priority 90
  requires:
    DOC_REVIEWERS 1
  source "Issue #27"

task POOL_HUMAN_TEXT_UI POOL_P0_READY -> POOL_HUMAN_TEXT_READY:
  title "Implement truthful Planning Pool human text results"
  description "Resolve Issue #29 for Work and Window show, observation, and reshape preflight with semantic text/JSON parity and stable goldens."
  duration 8p
  status done
  priority 90
  requires:
    CLI_ENGINEERS 1
    DOC_REVIEWERS 1
  source "Issue #29"

task POOL_INTENT_UI POOL_P0_READY -> POOL_INTENT_UI_READY:
  title "Add intent-oriented Planning Pool UI and onboarding"
  description "Resolve Issue #30 with a bounded direct-intent or request-builder contract, executable first-use workflows, and explicit failure recovery."
  duration 13p
  status done
  priority 90
  requires:
    CLI_ENGINEERS 1
    DOC_REVIEWERS 1
  source "Issue #30"

task POOL_REQUEST_SCHEMAS POOL_P0_READY -> POOL_REQUEST_SCHEMA_READY:
  title "Publish standalone Planning Pool request schemas"
  description "Resolve Issue #31 with three closed root schemas, catalog and package exposure, Help linkage, example compilation, and installed validation."
  duration 5p
  status done
  priority 90
  requires:
    SCHEMA_ENGINEERS 1
    CLI_ENGINEERS 1
  source "Issue #31"

task POOL_GOAL_BOUNDARY_GUIDANCE POOL_P0_READY -> POOL_GOAL_BOUNDARY_READY:
  title "Explain the Final Goal coverage non-guarantee"
  description "Resolve Issue #33 without implementing Issue #24 by making advisory Work, strict finish, and future Goal Coverage boundaries explicit to nontechnical users."
  duration 2p
  status done
  priority 90
  requires:
    DOC_REVIEWERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #33"

task POOL_COMPOUND_HELP POOL_P1_READY -> POOL_COMPOUND_HELP_READY:
  title "Accept command-shaped compound Help lookup"
  description "Resolve Issue #32 for natural path operands, incomplete-action recovery, backward compatibility, and all compound command resources."
  duration 2p
  status done
  priority 50
  requires:
    CLI_ENGINEERS 1
  source "Issue #32"

task POOL_ENTITY_INSPECTION POOL_P1_READY -> POOL_ENTITY_INSPECTION_READY:
  title "Expose Planning Event and Activity inspection"
  description "Resolve Issue #34 with read-only current entity detail, reverse Work associations, endpoints, human output, and closed JSON."
  duration 5p
  status done
  priority 50
  requires:
    CLI_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #34"

task POOL_RELEASE_INTEGRATION_ACCEPTANCE POOL_P2_READY -> POOL_INTEGRATED:
  title "Accept the corrected Planning Pool release surface end to end"
  description "Run the complete supported repository, static, documentation, self-use, adapter, Help, Guide, schema, temporary-link, isolated-package, and nontechnical UI gates."
  duration 8p
  status done
  priority 100
  requires:
    ACCEPTANCE_REVIEWERS 1
    CLI_ENGINEERS 1
    DOC_REVIEWERS 1
  source "Issues #25-#34"

task POOL_RELEASE_GATE_DESIGN POOL_GRAMMAR9_ACCEPTANCE_MUTATION_READY -> POOL_RELEASE_GATE_ACCEPTED:
  title "Accept the next-minor Planning Pool release gate"
  description "Resolve the release boundary under Issue #35 only after Issues #37 and #38 are independently accepted; provisionally select 0.11.0, freeze compatibility and rollback expectations, and retain publication as separately authorized."
  duration 3p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #35"

task POOL_RELEASE_PREPARATION POOL_RELEASE_GATE_ACCEPTED -> POOL_RELEASE_PREPARED:
  title "Prepare the next Planning Pool minor"
  description "Align all version-bearing surfaces and pass the complete local and installed preparation gates without publishing."
  duration 5p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
  source "Issue #35"

task POOL_RELEASE_CANDIDATE POOL_RELEASE_PREPARED -> POOL_RELEASE_CANDIDATE_ACCEPTED:
  title "Accept one immutable Planning Pool release candidate"
  description "Select one clean commit and tarball, prove unused external identities and routes, and accept exact installed behavior before publication authorization."
  duration 5p
  status done
  priority 100
  requires:
    RELEASE_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #35"

task POOL_RELEASE_PUBLISH POOL_RELEASE_CANDIDATE_ACCEPTED -> POOL_RELEASE_PUBLISHED:
  title "Publish the authorized Planning Pool minor"
  description "After separate authorization, push the exact commit and tag, require hosted CI, create the GitHub prerelease, and publish the byte-identical tarball once to npm beta."
  duration 3p
  status active
  priority 100
  requires:
    RELEASE_ENGINEERS 1
  source "Issue #35"

task POOL_RELEASE_ACCEPTANCE POOL_RELEASE_PUBLISHED -> POOL_RELEASE_ACCEPTED:
  title "Durably accept the published Planning Pool minor"
  description "Independently read back Git, CI, GitHub, npm, artifact identity, exact and beta installations, all review issues, and rollback without implying latest promotion or Issue closure."
  duration 5p
  status planned
  priority 100
  requires:
    RELEASE_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #35"

gate POOL_P1_GUIDE_JOIN POOL_GRAMMAR9_GUIDE_READY -> POOL_P1_READY:
  reason "Grammar 9 Guide correction accepted"

gate POOL_P1_TEXT_JOIN POOL_HUMAN_TEXT_READY -> POOL_P1_READY:
  reason "Human text UI accepted"

gate POOL_P1_INTENT_JOIN POOL_INTENT_UI_READY -> POOL_P1_READY:
  reason "Intent-oriented UI accepted"

gate POOL_P1_SCHEMA_JOIN POOL_REQUEST_SCHEMA_READY -> POOL_P1_READY:
  reason "Request schemas accepted"

gate POOL_P1_GOAL_JOIN POOL_GOAL_BOUNDARY_READY -> POOL_P1_READY:
  reason "Goal boundary guidance accepted"

gate POOL_P2_HELP_JOIN POOL_COMPOUND_HELP_READY -> POOL_P2_READY:
  reason "Compound Help correction accepted"

gate POOL_P2_ENTITY_JOIN POOL_ENTITY_INSPECTION_READY -> POOL_P2_READY:
  reason "Planning entity inspection accepted"

task POOL_GRAMMAR9_ACCEPTANCE_MUTATION POOL_INTEGRATED -> POOL_GRAMMAR9_ACCEPTANCE_MUTATION_READY:
  title "Restore milestone acceptance mutation on Grammar 9"
  description "Correct the Contract 10 composition so Grammar 9 milestone criterion and receipt mutations preserve Planning Pool declarations, canonical governance, candidate identity, and safe-write guards; add cross-version CLI and installed-package regression before release gate acceptance."
  duration 3p
  status done
  priority 100
  requires:
    CLI_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #35 independent release-gate review"

task POOL_GOVERNANCE_BINDING_FIX POOL_GRAMMAR9_ACCEPTANCE_MUTATION_READY -> POOL_GOVERNANCE_BINDING_READY:
  title "Bind lifted governance decisions to authoritative source bytes"
  description "Resolve Issue #38 by rebinding every lifted GovernanceDecision.v2 to the authoritative outer source across Grammar 7 through 9 while preserving candidate bytes, authority, safe-write guards, and result identities; cover Core, CLI, and installed-package paths."
  duration 5p
  status done
  priority 100
  requires:
    CLI_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #38"

task POOL_NEXT_SIGNAL_CONSISTENCY POOL_GRAMMAR9_ACCEPTANCE_MUTATION_READY -> POOL_NEXT_SIGNAL_READY:
  title "Make recommendation and runnable authority coherent"
  description "Resolve Issue #37 by defining one coherent current-start authority across recommendation and capacity selection, explicitly typing any informational non-executable recommendation, preserving ranking meaning and source-plan integrity, and covering JSON, text, schema, and installed-package paths."
  duration 8p
  status done
  priority 100
  requires:
    CLI_ENGINEERS 1
    ACCEPTANCE_REVIEWERS 1
  source "Issue #37"

