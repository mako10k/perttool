# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_051:
  version 5
  title "perttool 0.5.1 compatible Contract 6 beta patch release"
  description "Release suffix-free 0.5.1 beta as a backward-compatible CLI Contract 6 and Grammar 5 patch from one verified artifact. RELEASE_051_SELF_REVIEW, RELEASE_051_PREPARATION, and RELEASE_051_CANDIDATE completed 11p under the user authorized complete named release. The clean candidate passed Node.js 22.22.3 repository and installed-package gates, absent tag, GitHub Release, and npm version checks, unchanged dist-tag baselines, protected routes, and the retained 491-file tarball with SHA-256 93f3e01a...1339. Six points remain; precedence and heuristic resource makespans are 6p at the observed 11p/1d velocity, both forecast at 6/11d. Complete NextResult v5 should recommend RELEASE_051_PUBLISH. npm latest promotion and Issue #5 closure remain separate decisions."
  as_of 2026-07-30
  duration_unit point
  velocity 11p/1d
  finish RELEASE_051_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1



milestone RELEASE_051_CANDIDATE_ACCEPTED:
  title "Version 0.5.1 release candidate accepted"
  state reached

milestone RELEASE_051_PUBLISHED:
  title "Version 0.5.1 published to GitHub and npm beta"

milestone RELEASE_051_ACCEPTED:
  title "Version 0.5.1 compatible Contract 6 beta patch accepted"




task RELEASE_051_PUBLISH RELEASE_051_CANDIDATE_ACCEPTED -> RELEASE_051_PUBLISHED:
  title "Publish version 0.5.1 from one immutable tarball"
  description "Only after every predecessor gate passes and under the user's named 0.5.1 authorization, push and verify the clean release commit and annotated tag, publish the GitHub prerelease and SHA256SUMS, install its asset, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.5.1 while latest remains unchanged."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1

task RELEASE_051_ACCEPTANCE RELEASE_051_PUBLISHED -> RELEASE_051_ACCEPTED:
  title "Record durable 0.5.1 beta acceptance"
  description "Verify release commit and peeled tag identity, common candidate, GitHub, and npm tarball digest, registry integrity and metadata, isolated installation from both public channels, unchanged Contract 6 and Grammar 5 behavior, schema discovery, beta and unchanged latest tags, and exact commands. Record acceptance without altering the immutable artifact, promoting latest, or closing Issue #5."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
