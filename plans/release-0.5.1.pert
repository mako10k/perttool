# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_051:
  version 5
  title "perttool 0.5.1 compatible Contract 6 beta patch release"
  description "Release suffix-free 0.5.1 beta as a backward-compatible CLI Contract 6 and Grammar 5 patch from one verified artifact. All five tasks and 17p completed over one active day under the user-authorized complete named release. Release commit and peeled v0.5.1 target 31d162a agree; Node.js 22 and 24 CI passed; candidate, GitHub, and npm tarballs are byte-identical at SHA-256 93f3e01a...1339; publication moved beta to 0.5.1 while preserving latest=0.4.0; and independent isolated checks of both public artifacts passed. The additive schema surface retained Grammar 5, CLI Contract 6, all 33 prior commands, all 108 prior exports, result identities, and normalized payload meanings. Immediate npm verification exceeded its bounded propagation window, but no retry occurred and independent reads established durable publication. After acceptance, the user separately authorized one npm dist-tag mutation; authenticated identity mako10k moved latest to 0.5.1, and fresh registry reads plus an unqualified isolated installation confirmed beta=latest=0.5.1, CLI Contract 6, Grammar 5, and 18-schema discovery. Both makespans are zero at observed 17p/1d; complete NextResult v5 has no ready, recommended, or startable task. Issue #5 closure remains a separate decision."
  as_of 2026-07-30
  duration_unit point
  velocity 17p/1d
  finish RELEASE_051_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1





milestone RELEASE_051_ACCEPTED:
  title "Version 0.5.1 compatible Contract 6 beta patch accepted"
  state reached
