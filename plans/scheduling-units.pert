project SCHEDULING_UNITS:
  version 1
  title "Temporal properties, deadlines, and unit migration roadmap"
  description "Track TIME-001 and UNIT-001 as milestone-level work packages without duplicating detail task state. SU-M1, SU-M2, SU-M2R, and SU-M4 are accepted and advanced. The SU-M4 detail completed 25p at 25p/1d and was rolled up once. SU-M3 remains estimated at 23p using inherited 24p/1d velocity and is the only ready and recommended macro work package. The remaining precedence and heuristic resource makespans are both 1.958333d with no delay. SU-M5 atomic Contract 4 activation follows the accepted SU-M3 and SU-M4 branches; release and external distribution remain separate decisions."
  as_of 2026-07-25
  duration_unit day
  finish SCHEDULING_UNITS_ACCEPTED

resource DEVELOPERS:
  title "Design and implementation capacity"
  capacity 2

resource REVIEWERS:
  title "Normative contract and acceptance review capacity"
  description "Only one public-contract or acceptance review runs at a time"
  capacity 1

resource PUBLIC_SURFACE:
  title "Grammar, Core, CLI, help, and result projection ownership"
  description "Serialize work packages that change shared public interfaces"
  capacity 1

resource PACKAGE_SURFACE:
  title "Self-use, link, and installed-package acceptance ownership"
  capacity 1




milestone DEADLINE_CAPABILITIES_ACCEPTED:
  title "SU-M3 temporal deadline and Next v4 target Core accepted"

milestone UNIT_MIGRATION_ACCEPTED:
  title "SU-M4 exact unit-migration Core accepted"
  state reached

milestone DELIVERY_INPUT_READY:
  title "Deadline and migration Core branches accepted"

milestone SCHEDULING_UNITS_ACCEPTED:
  title "SU-M5 atomic Contract 4 workstream accepted"



task SU_M3_DEADLINE_CAPABILITY_WORK_PACKAGE RATIONAL_DURATION_ACCEPTED -> DEADLINE_CAPABILITIES_ACCEPTED:
  title "Implement temporal deadline and Next v4 target Core"
  description "Re-estimated milestone package: 23p at the inherited 24p/1d velocity, recorded as a six-decimal 0.958333d macro resource forecast. Implement target calendar projection, release-aware temporal precedence and heuristic resource views, deadline evaluation, AnalysisResult v3 projection, and NextResult v4 time-gated authority Core with the unchanged complete v3 recommendation graph. Do not activate the public CLI, result schemas, or normal authority in this slice."
  duration 0.958333d
  priority 90
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PUBLIC_SURFACE 1


gate DEADLINE_ACCEPTANCE_GATE DEADLINE_CAPABILITIES_ACCEPTED -> DELIVERY_INPUT_READY:
  reason "Atomic Contract 4 acceptance requires the temporal deadline and Next v4 target Core"

gate UNIT_MIGRATION_ACCEPTANCE_GATE UNIT_MIGRATION_ACCEPTED -> DELIVERY_INPUT_READY:
  reason "Atomic Contract 4 acceptance requires the exact unit-migration target Core"

task SU_M5_INTEGRATED_ACCEPTANCE DELIVERY_INPUT_READY -> SCHEDULING_UNITS_ACCEPTED:
  title "Accept atomic Contract 4 and the integrated workstream"
  description "Atomically cut over CLI Contract 4, public result schemas, registry dispatch, text/JSON help, Guide, README, installed-package workflows, and Next v4 normal start authority after shadow and unknown-result safe-stop acceptance. Run cross-feature regression, self-use, link, and package gates. Decide release scope separately; this task does not authorize a Git push, GitHub release, npm publication, or dist-tag change."
  duration 1d
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1

milestone RATIONAL_DURATION_ACCEPTED:
  title "Exact rational Duration target extension accepted"
  state reached
