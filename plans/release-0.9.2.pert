# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_092:
  version 6
  title "perttool 0.9.2 point-without-velocity emergency patch release"
  description "Release suffix-free 0.9.2 beta as a backward-compatible Grammar 7 and CLI Contract 8 patch for ANALYSIS-001 and Issue #15. Keep valid Point plans without velocity point-valued, expose calendar conversion as unavailable, and retain every public identity and authority boundary. npm latest promotion and plan advance remain separate."
  as_of 2026-08-14
  duration_unit point
  velocity 18p/1d
  finish RELEASE_092_ACCEPTED
  goal_owner user
  dag_owner user

milestone RELEASE_092_PLANNING_STARTED:
  title "Version 0.9.2 emergency release planning started"
  state reached

resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, correction, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub prerelease, npm beta publication, and durable verification."
  capacity 1

milestone RELEASE_092_REVIEW_ACCEPTED:
  title "Version 0.9.2 compatibility review accepted"

milestone RELEASE_092_CORRECTION_ACCEPTED:
  title "Issue 15 correction accepted"

milestone RELEASE_092_SOURCE_PREPARED:
  title "Version 0.9.2 release source prepared"

milestone RELEASE_092_CANDIDATE_ACCEPTED:
  title "Version 0.9.2 release candidate accepted"

milestone RELEASE_092_PUBLISHED:
  title "Version 0.9.2 published to GitHub and npm beta"

milestone RELEASE_092_ACCEPTED:
  title "Version 0.9.2 point-without-velocity patch accepted"

task RELEASE_092_SELF_REVIEW RELEASE_092_PLANNING_STARTED -> RELEASE_092_REVIEW_ACCEPTED:
  title "Review the 0.9.2 compatibility and emergency release boundary"
  description "Confirm the exact v0.9.1 baseline, source-level Issue #15 reproduction, patch version 0.9.2, unchanged Grammar 7, CLI Contract 8, command, result, schema, facade, and authority identities, current beta/latest channels, and the bounded emergency release procedure. This task performs no external write."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
  source "ANALYSIS-001"

task RELEASE_092_CORRECTION RELEASE_092_REVIEW_ACCEPTED -> RELEASE_092_CORRECTION_ACCEPTED:
  title "Accept the Issue 15 point-without-velocity correction"
  description "Remove the invalid temporal-layer velocity assertion, preserve Point base analysis and recommendation authority, expose missing calendar conversion explicitly, and pass file/stdin regressions for document check, project show, all analysis modes, and dag next without changing unrelated behavior."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
  source "ANALYSIS-001"

task RELEASE_092_PREPARATION RELEASE_092_CORRECTION_ACCEPTED -> RELEASE_092_SOURCE_PREPARED:
  title "Prepare version 0.9.2 release source"
  description "Align package and lockfile identity, CLI version, adapter peer versions, MCP server identity, CHANGELOG, README, release documentation, tests, goldens, self-use registration, dependency audit, and beta publication validation. Run the complete Node.js 22 repository and package gates without remote or registry writes."
  duration 4p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
  source "ANALYSIS-001"

task RELEASE_092_CANDIDATE RELEASE_092_SOURCE_PREPARED -> RELEASE_092_CANDIDATE_ACCEPTED:
  title "Accept one clean 0.9.2 release candidate"
  description "Commit and recheck the complete release diff; prove package, tag, GitHub Release, and npm version availability; verify beta=0.9.1, latest=0.9.0, and no alpha; verify authenticated routes; build one immutable tarball outside the worktree; and accept its exact identity and installed Issue #15 behavior. This task performs no external write."
  duration 3p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
  source "ANALYSIS-001"

task RELEASE_092_PUBLISH RELEASE_092_CANDIDATE_ACCEPTED -> RELEASE_092_PUBLISHED:
  title "Publish version 0.9.2 from one immutable tarball"
  description "Only after every predecessor gate passes, push and verify the clean release commit and annotated tag, require Node.js 22 and 24 CI, publish one GitHub prerelease and SHA256SUMS, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.9.2 while latest remains 0.9.0."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1
  source "ANALYSIS-001"

task RELEASE_092_ACCEPTANCE RELEASE_092_PUBLISHED -> RELEASE_092_ACCEPTED:
  title "Record durable 0.9.2 emergency patch acceptance"
  description "Independently verify release commit and peeled tag identity, successful CI, common candidate, GitHub and npm tarball bytes, registry integrity and metadata, exact and beta installations, Issue #15 behavior, compatibility, and the exact 0.9.1 rollback pin. Install exact 0.9.2 locally and update Issue #15 after durable acceptance without changing latest, advancing the plan, or starting unrelated work."
  duration 2p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
  source "ANALYSIS-001"

