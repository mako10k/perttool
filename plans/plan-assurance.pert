milestone ASSURE_HASH_INSPECTION_READY:
  title "Read-only task hash inspection ready"

task ASSURE_HASH_INSPECTION ASSURE_CORE_INPUT -> ASSURE_HASH_INSPECTION_READY:
  title "Implement pinpoint read-only assurance hash inspection"
  description "Implement the read-only plan-assurance hash command and task-filtered show projection over the shared semantic and hash Core. Require an explicit contract, computed-basis, or exported selector; emit exactly one lowercase SHA-256 digest in text success, retain source identity in structured output, return no digest for unavailable selections, and document that inspection neither updates seals nor authorizes manual reseal."
  duration 3p
  status planned
  priority 90
  requires:
    DEVELOPERS 1
    ASSURANCE_CORE 1
    CLI_SURFACE 1

gate ASSURE_HASH_INSPECTION_PUBLIC_INPUT ASSURE_HASH_INSPECTION_READY -> ASSURE_PUBLIC_INPUT:
  reason "Public activation requires deterministic pinpoint hash inspection and direct-edit guidance"

