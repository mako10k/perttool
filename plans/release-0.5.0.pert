# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_050:
  version 5
  title "perttool 0.5.0 Contract 6 beta release"
  description "Release suffix-free 0.5.0 beta from the accepted atomic Grammar 5 and CLI Contract 6 source and one verified tarball. All six tasks and 19p are accepted under the user's authorization for the complete named 0.5.0 release and exact post-release local installation. Release commit and peeled v0.5.0 target af819b4 agree; the retained candidate, GitHub, and npm tarballs are byte-identical at SHA-256 f3ba9b3f...2208c; npm reports beta=0.5.0, latest=0.4.0, and alpha=0.1.0-alpha.2; and independent acceptance reran both public-package workflows. Precedence and heuristic resource makespans are zero at the observed 19p/1d velocity, with no ready or recommended task. The exact local installation remains the separately ordered post-acceptance step. npm latest promotion and Issue #4 closure remain separate decisions."
  as_of 2026-07-29
  duration_unit point
  velocity 19p/1d
  finish RELEASE_050_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize scope, contract, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, migration guidance, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1






milestone RELEASE_050_ACCEPTED:
  title "Version 0.5.0 Contract 6 beta accepted"
  state reached
