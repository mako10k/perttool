project AGENT_GUIDANCE:
  version 1
  title "Issue #2 AI Agent Guidance Registry実装計画"
  description "Codex、GitHub Copilot、Claude Code、Grok Build、Antigravity向けのread-only AI Agent Guidance Registry v1を提供する。Provider固有概念を共通taxonomyへmappingし、offline deterministicなCore、agent help text/JSON、fixture、package acceptanceを同じregistryから提供する。5 task全22pを2026-07-23の1 active dayで完了し、実測Velocityは22p/1dである。受け入れ証跡はdocs/process/agent-guidance-acceptance.mdを正とする。Audit、scaffold、hook実行、enforcement、runtime web refreshは対象外とする。"
  as_of 2026-07-23
  duration_unit point
  velocity 22p/1d
  finish GUIDANCE_ACCEPTED

resource DEVELOPERS:
  title "Guidance設計・実装担当枠"
  capacity 2

resource REVIEWERS:
  title "Provider事実・interface・securityレビュー枠"
  description "Provider mapping、公開schema、hook trust境界の受け入れを同時に1件だけ行う"
  capacity 1

resource CLI_SURFACE:
  title "CLI・help公開surface所有枠"
  description "src/cli.ts、src/index.ts、help registry、CLI testの同時変更を避ける"
  capacity 1

milestone GUIDANCE_ACCEPTED:
  title "Issue #2 read-only v1受け入れ完了"
  state reached
