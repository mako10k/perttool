project RECOMMENDATION_IMPLEMENTATION:
  version 1
  title "Recommendation implementation and self-use migration"
  description |
    Implement MIG-01 through MIG-07 from docs/process/recommendation-migration.md through the read-only recommendation in MVP acceptance condition 16 and adoption as the normal authority.
    Points are relative estimates from this roadmap reconstruction. On 2026-07-23, FIXTURE_BASELINE 2p, RANKING_CORE 4p, EXPLANATION_CORE 5p, NEXT_V3_PUBLICATION 4p, SELF_USE_SHADOW 2p, OVERRIDE_VALIDATION 3p, and AUTHORITY_ADOPTION 2p completed.
    The cumulative one-active-day sample calibrated a provisional recommendation-specific measured velocity of 22p/1d.
    MIG-08 override apply and durable audit remain an independent post-MVP work package.
  as_of 2026-07-23
  duration_unit point
  velocity 22p/1d
  finish RECOMMENDATION_MVP_READY

resource DEVELOPERS:
  title "Recommendation implementation capacity"
  capacity 2

resource REVIEWERS:
  title "Specification, publication, and self-use review capacity"
  capacity 1

milestone NOW:
  title "Recommendation design accepted and Stage 3 complete"
  state reached

milestone FIXTURE_BASELINE_READY:
  title "MIG-01 v2-compatible fixture baseline complete"

milestone RANKING_CORE_READY:
  title "MIG-02 ranking and tier Core complete"

milestone EXPLANATION_CORE_READY:
  title "MIG-03 explanation-graph Core complete"

milestone NEXT_V3_PUBLISHED:
  title "MIG-04 NextResult.v3 published"

milestone OVERRIDE_VALIDATION_READY:
  title "MIG-05 read-only override validation complete"

milestone SHADOW_ACCEPTED:
  title "MIG-06 self-use shadow accepted"

milestone NORMAL_AUTHORITY_ADOPTED:
  title "MIG-07 normal recommendation authority adopted"

milestone RECOMMENDATION_MVP_READY:
  title "MVP recommendation accepted"

task FIXTURE_BASELINE NOW -> FIXTURE_BASELINE_READY:
  title "Capture normative cases and the v2-compatible baseline as fixtures"
  description "Fix REC-001 through REC-011 in test/fixtures/recommendation and goldens without changing the public schema"
  duration 2p
  status done
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task RANKING_CORE FIXTURE_BASELINE_READY -> RANKING_CORE_READY:
  title "Implement candidate facts, ranking, and tier Core"
  description "Implement selection horizon, complete order, and a joint-feasible recommended set as pure code in src/recommendation, with exact and stable unit tests"
  duration 4p
  status done
  priority 90
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task EXPLANATION_CORE RANKING_CORE_READY -> EXPLANATION_CORE_READY:
  title "Implement the structured explanation graph and invariants"
  description "Fix typed facts, expressions, comparisons, decision traces, canonical descriptions, and PTREC failures in Core and tests"
  duration 5p
  status done
  priority 80
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task NEXT_V3_PUBLICATION EXPLANATION_CORE_READY -> NEXT_V3_PUBLISHED:
  title "Publish NextResult.v3 atomically through Core, CLI, and help"
  description "Update src/application/next.ts, src/cli.ts, src/index.ts, help, README, CHANGELOG, the consumer guide, and Core/CLI/package tests in the same breaking change"
  duration 4p
  status done
  priority 70
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task SELF_USE_SHADOW NEXT_V3_PUBLISHED -> SHADOW_ACCEPTED:
  title "Run recommendation shadow evaluation across five plans"
  description "Verify byte determinism, a complete graph, resource feasibility, v2 operational-field compatibility, and explanations of why A rather than B with self-use goldens"
  duration 2p
  status done
  priority 60
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task OVERRIDE_VALIDATION NEXT_V3_PUBLISHED -> OVERRIDE_VALIDATION_READY:
  title "Implement read-only override validation"
  description "Verify pure validateOverride, the PTOVR result, feasible replacement, and canonical artifact IDs without filesystem, Git, or network side effects"
  duration 3p
  status done
  priority 50
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task AUTHORITY_ADOPTION SHADOW_ACCEPTED -> NORMAL_AUTHORITY_ADOPTED:
  title "Adopt normal recommendations as the AI task-selection authority"
  description "Synchronize AGENTS.md, Copilot instructions, the AI development guide, and help with the v3 consumer rule; dry-run the unknown-version safe stop"
  duration 2p
  status done
  priority 40
  requires:
    DEVELOPERS 1
    REVIEWERS 1

gate AUTHORITY_MVP_GATE NORMAL_AUTHORITY_ADOPTED -> RECOMMENDATION_MVP_READY:
  reason "The MVP requires shadow acceptance and adoption of normal recommendation authority"

gate OVERRIDE_MVP_GATE OVERRIDE_VALIDATION_READY -> RECOMMENDATION_MVP_READY:
  reason "The MVP requires read-only validation that can express a human override"
