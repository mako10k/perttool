# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_052:
  version 5
  title "perttool 0.5.2 compatible JSON Schema patch release"
  description "Release suffix-free 0.5.2 beta as a backward-compatible CLI Contract 6 and Grammar 5 patch. Complete nested result schemas and explicit full and reference-based outline/detail views retain the default full lookup mode and query projection, result identities, payload meanings, all 34 commands, and all 116 runtime exports. SELF_REVIEW, PREPARATION, CANDIDATE, PUBLISH, and ACCEPTANCE completed 17p over one active day. Release commit and peeled v0.5.2 target 501d4b1 agree; Node.js 22 and 24 CI run 30517079581 passed; candidate, GitHub, and npm tarballs are byte-identical at SHA-256 e8512f0d3e20764e9397af827f6ea57f8bea7361d1e414102b0350bcaa54bbce; both public-package workflows and the exact 0.5.1 compatibility comparison passed; npm beta=0.5.2 and latest=0.5.1. Both makespans are zero and complete NextResult v5 has no recommendation. npm latest promotion and Issue #5 closure remain separate decisions."
  as_of 2026-07-30
  duration_unit point
  velocity 17p/1d
  finish RELEASE_052_ACCEPTED
  goal_owner user
  dag_owner user


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize compatibility, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, immutable tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1





milestone RELEASE_052_ACCEPTED:
  title "Version 0.5.2 compatible JSON Schema patch accepted"
  state reached
