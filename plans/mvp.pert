project PERTTOOL_MVP:
  version 1
  title "perttool MVPマイルストーン計画"
  description |
    MVP全体のmacro PERT。各durationは現時点のengineering-day見積りであり、
    grammar sliceはplans/grammar.pert、AI工程制御設計はplans/control-plane.pertを正とする。
    Issue #1の受け入れ済み設計とgrammarの受け入れを入力としてM1を確定する。
    M1後はformatter、mutation preview、safe write、advanceの操作系を最優先し、
    recommendation実装とIssue #2は操作系を遅らせないcapacityでだけ並行する。
  as_of 2026-07-22
  duration_unit day
  finish M6_MVP_RELEASED

resource DEVELOPERS:
  title "実装担当枠"
  capacity 2

resource REVIEWERS:
  title "設計・安全性レビュー枠"
  description "仕様判断と安全性gateは同時に1件だけレビューする"
  capacity 1

milestone NOW:
  title "read-only core完成"
  state reached

milestone GRAMMAR_ACCEPTED:
  title "文法受け入れ完了"

milestone CONTROL_PLANE_DESIGN_ACCEPTED:
  title "AI工程制御設計受け入れ完了"

milestone FOUNDATION_INPUTS_ACCEPTED:
  title "product foundationの設計入力受け入れ完了"

milestone M1_PRODUCT_FOUNDATION_READY:
  title "M1 product foundationと実装roadmap確定"

milestone FORMATTER_READY:
  title "formatter基礎完了"

milestone MUTATION_PREVIEW_READY:
  title "構造編集preview完了"

milestone M2_EDIT_PREVIEW_READY:
  title "M2 安全な編集preview完了"

milestone M3_SAFE_WRITE_READY:
  title "M3 安全なwrite完了"

milestone M4_ADVANCE_READY:
  title "M4 過去圧縮advance完了"

milestone MERMAID_PROFILE_DEFINED:
  title "Mermaid lossless profile確定"

milestone MERMAID_EXPORT_READY:
  title "Mermaid export完了"

milestone M5_MERMAID_ROUNDTRIP_READY:
  title "M5 Mermaid相互変換完了"

milestone RELEASE_READY:
  title "MVP release検証可能"

milestone M6_MVP_RELEASED:
  title "M6 MVPリリース"

task CONTROL_PLANE_DESIGN_WORK_PACKAGE NOW -> CONTROL_PLANE_DESIGN_ACCEPTED:
  title "AI工程制御planeを設計する"
  description "plans/control-plane.pertのIssue #1設計17pを2026-07-22に受け入れた。durationは受け入れ前にroll-upした残り1pの実測velocity forecast 1/16dを保持する"
  duration 0.0625d
  status done
  priority 100
  requires:
    DEVELOPERS 1

task GRAMMAR_WORK_PACKAGE NOW -> GRAMMAR_ACCEPTED:
  title "grammar planの残作業を完了する"
  description "詳細日程はplans/grammar.pertのresource makespan 5p、直近実測velocity forecast 1dを使用する"
  duration 1d
  priority 50
  requires:
    DEVELOPERS 1

gate CONTROL_PLANE_FOUNDATION_GATE CONTROL_PLANE_DESIGN_ACCEPTED -> FOUNDATION_INPUTS_ACCEPTED:
  reason "product foundationの再構成にはAI工程制御planeの設計受け入れが必要"

gate GRAMMAR_FOUNDATION_GATE GRAMMAR_ACCEPTED -> FOUNDATION_INPUTS_ACCEPTED:
  reason "product foundationの再構成には文法受け入れが必要"

task M1_ROADMAP_UPDATE FOUNDATION_INPUTS_ACCEPTED -> M1_PRODUCT_FOUNDATION_READY:
  title "操作系優先でM1実装roadmapを確定する"
  description "formatter、mutation preview、safe write、advanceを最優先trackとして詳細化する。recommendationとIssue #2はこのtrackを遅らせない場合だけ並行化する"
  duration 1d
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task FORMATTER_CORE M1_PRODUCT_FOUNDATION_READY -> FORMATTER_READY:
  title "source-preserving formatterを実装する"
  duration 4d
  priority 100
  requires:
    DEVELOPERS 1

task MUTATION_PREVIEW M1_PRODUCT_FOUNDATION_READY -> MUTATION_PREVIEW_READY:
  title "task、milestone、resource編集previewを実装する"
  duration 4d
  priority 100
  requires:
    DEVELOPERS 1

gate FORMATTER_EDIT_GATE FORMATTER_READY -> M2_EDIT_PREVIEW_READY:
  reason "編集previewにはformatterが必要"

gate MUTATION_EDIT_GATE MUTATION_PREVIEW_READY -> M2_EDIT_PREVIEW_READY:
  reason "編集previewにはmutation plannerが必要"

task WRITE_SAFETY M2_EDIT_PREVIEW_READY -> M3_SAFE_WRITE_READY:
  title "再検査、atomic write、optimistic lockを実装する"
  duration 3d
  priority 90
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task ADVANCE M3_SAFE_WRITE_READY -> M4_ADVANCE_READY:
  title "合流を保持するadvance plannerを実装する"
  duration 4d
  priority 20
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task MERMAID_PROFILE M3_SAFE_WRITE_READY -> MERMAID_PROFILE_DEFINED:
  title "Mermaid lossless metadata schemaを確定する"
  duration 2d
  priority 20
  requires:
    DEVELOPERS 1
    REVIEWERS 1

task MERMAID_EXPORT MERMAID_PROFILE_DEFINED -> MERMAID_EXPORT_READY:
  title "AoA DAGをMermaidへexportする"
  duration 3d
  priority 15
  requires:
    DEVELOPERS 1

task MERMAID_ROUNDTRIP MERMAID_EXPORT_READY -> M5_MERMAID_ROUNDTRIP_READY:
  title "lossless importとround-trip検査を実装する"
  duration 5d
  priority 10
  requires:
    DEVELOPERS 1
    REVIEWERS 1

gate ADVANCE_RELEASE_GATE M4_ADVANCE_READY -> RELEASE_READY:
  reason "MVPにはadvance完了が必要"

gate MERMAID_RELEASE_GATE M5_MERMAID_ROUNDTRIP_READY -> RELEASE_READY:
  reason "MVPにはMermaid相互変換完了が必要"

task RELEASE_E2E RELEASE_READY -> M6_MVP_RELEASED:
  title "MVP E2E、help、配布物を検証する"
  duration 2d
  priority 5
  requires:
    DEVELOPERS 1
    REVIEWERS 1
