project PERTTOOL_MVP:
  version 1
  title "perttool macro roadmap through first beta"
  description "Completed macro roadmap through the first suffix-free beta. Version 0.1.0 was published from one verified tarball to a GitHub prerelease and the npm beta dist-tag while latest remained 0.1.0-alpha.2. Post-beta workstreams are tracked in independent plans; release evidence is recorded in docs/process/beta-release-acceptance.md and Git history."
  as_of 2026-07-23
  duration_unit day
  finish M8_BETA_RELEASED

resource DEVELOPERS:
  title "実装担当枠"
  capacity 2

resource REVIEWERS:
  title "設計・安全性レビュー枠"
  description "仕様判断と安全性gateは同時に1件だけレビューする"
  capacity 1

milestone M8_BETA_RELEASED:
  title "M8 suffix-free 0.x beta released"
  description "Version 0.1.0 release, registry installation, and artifact parity accepted"
  state reached
