project SCHEDULING_UNITS_M2:
  version 1
  title "SU-M2 temporal source and Core foundations"
  description "Implement and accept only the target Grammar 2 temporal source and Core foundations selected by the SU-M1 contract. The active runtime remains Grammar 1 and CLI Contract 3. Public Contract 4 schemas, descriptors, help, Guide, README examples, installed-package temporal workflows, temporal analysis, Next v4 authority, unit migration, and publication are outside this plan. All six SU-M2 tasks are accepted at an observed cumulative velocity of 24p/1d on one active day. SU-M3 owns target calendar, deadline, temporal schedule, and Next v4 Core; SU-M4 owns exact unit migration; SU-M5 owns atomic public activation."
  as_of 2026-07-25
  duration_unit point
  velocity 24p/1d
  finish M2_FOUNDATIONS_ACCEPTED


resource DEVELOPERS:
  title "Implementation capacity"
  description "Two independent target-only Core slices may run together when file ownership does not overlap"
  capacity 2

resource REVIEWERS:
  title "Grammar and compatibility review capacity"
  description "Only one source-contract or compatibility acceptance review runs at a time"
  capacity 1

resource SYNTAX_SURFACE:
  title "Parser, CST/AST, validator, and formatter ownership"
  capacity 1

resource MUTATION_SURFACE:
  title "Temporal mutation and batch ownership"
  capacity 1

resource TARGET_CORE_SURFACE:
  title "Target CalendarValue and declared-input Core ownership"
  description "Target-only types do not enter active CLI adapters or package exports before SU-M5"
  capacity 1

resource CONTRACT3_GUARD:
  title "Active Grammar 1 and CLI Contract 3 compatibility gate"
  capacity 1







milestone M2_FOUNDATIONS_ACCEPTED:
  title "SU-M2 temporal source and Core foundations accepted"
  state reached
