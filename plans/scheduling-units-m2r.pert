project SCHEDULING_UNITS_M2R:
  version 1
  title "Exact rational Duration extension"
  description "Plan and accept an exact rational Duration extension before SU-M3 and SU-M4. Active Grammar 1, accepted target Grammar 2, and CLI Contract 3 stay closed. The first task selects new grammar, unit-migration, and result or interface version identities where compatibility requires them, then defines fraction syntax, canonical serialization, a versioned source-upgrade boundary, and reversibility qualification. Implementation remains internal until SU-M5."
  as_of 2026-07-25
  duration_unit point
  velocity 24p/1d
  finish RATIONAL_DURATION_ACCEPTED


resource DEVELOPERS:
  title "Implementation capacity"
  description "Two independent rational-Duration slices may run together when ownership does not overlap"
  capacity 2

resource REVIEWERS:
  title "Normative and compatibility review capacity"
  capacity 1

resource NORMATIVE_SURFACE:
  title "Requirements, specifications, design, and examples ownership"
  capacity 1

resource SYNTAX_SURFACE:
  title "Target parser, CST/AST, validator, and formatter ownership"
  capacity 1

resource MUTATION_SURFACE:
  title "Target mutation and batch ownership"
  capacity 1

resource TARGET_CORE_SURFACE:
  title "Exact Rational source serialization and target candidate ownership"
  capacity 1

resource CONTRACT3_GUARD:
  title "Active Grammar 1 and CLI Contract 3 compatibility gate"
  capacity 1




milestone RATIONAL_DURATION_CORE_INPUT_READY:
  title "Rational source and serializer branches ready"
  state reached

milestone RATIONAL_DURATION_FORMATTER_READY:
  title "Target rational Duration formatter ready"
  state reached

milestone RATIONAL_DURATION_MUTATION_READY:
  title "Target rational Duration mutation ready"
  state reached

milestone RATIONAL_DURATION_VERSION_BOUNDARY_READY:
  title "Grammar upgrade and compatibility boundary ready"

milestone RATIONAL_DURATION_ACCEPTANCE_INPUT_READY:
  title "Rational Duration branches ready for acceptance"

milestone RATIONAL_DURATION_ACCEPTED:
  title "Exact rational Duration extension accepted"








task RATIONAL_DURATION_VERSION_BOUNDARY RATIONAL_DURATION_CORE_INPUT_READY -> RATIONAL_DURATION_VERSION_BOUNDARY_READY:
  title "Implement the rational Duration version boundary"
  description "Implement the internal candidate boundary that upgrades a source document to the newly selected target grammar only when an exact generated fraction requires it, reports the selected grammar and related compatibility metadata changes in reversibility, preserves temporal source, and leaves public schemas, exports, dispatch, help, and installed behavior unchanged."
  duration 3p
  status done
  priority 70
  requires:
    DEVELOPERS 1
    TARGET_CORE_SURFACE 1
    CONTRACT3_GUARD 1

gate FORMATTER_ACCEPTANCE_GATE RATIONAL_DURATION_FORMATTER_READY -> RATIONAL_DURATION_ACCEPTANCE_INPUT_READY:
  reason "Acceptance requires target formatter support"

gate MUTATION_ACCEPTANCE_GATE RATIONAL_DURATION_MUTATION_READY -> RATIONAL_DURATION_ACCEPTANCE_INPUT_READY:
  reason "Acceptance requires target mutation and batch support"

gate VERSION_BOUNDARY_ACCEPTANCE_GATE RATIONAL_DURATION_VERSION_BOUNDARY_READY -> RATIONAL_DURATION_ACCEPTANCE_INPUT_READY:
  reason "Acceptance requires the selected version identities and source-grammar compatibility boundary"

task RATIONAL_DURATION_ACCEPTANCE RATIONAL_DURATION_ACCEPTANCE_INPUT_READY -> RATIONAL_DURATION_ACCEPTED:
  title "Accept exact rational Duration without public activation"
  description "Trace the revised TUI and TUE observations; replace TUE-015 failure with exact fraction success; cover malformed fractions, Decimal compatibility, round trips, version identities, and source-grammar upgrade behavior; verify target APIs remain unexported and the installed Contract 3 CLI rejects the new target grammar; run full repository, link, and package gates; and hand the exact syntax to SU-M3 and SU-M4."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    NORMATIVE_SURFACE 1
    SYNTAX_SURFACE 1
    MUTATION_SURFACE 1
    TARGET_CORE_SURFACE 1
    CONTRACT3_GUARD 1
