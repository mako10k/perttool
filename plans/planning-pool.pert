# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project PLANNING_POOL:
  version 7
  title "Work-centered planning pool and bounded Windows"
  description "Implement PLAN-POOL-001 and Issue #12 as an independent single-document Work-centered planning workstream. First accept one normative contract for Work, project-owned Event and Activity AoA, active persisted and ad hoc Windows, semantic reshape, ownership-transfer projection, narrow deferral, observation, archival, and bounded Git reconstruction. Then implement source semantics, governed mutations, read models, history composition, the public CLI contract, and complete acceptance. Preserve the current strict DAG, one project finish, Task actuals and velocity, Milestone outcome acceptance, governance, plan assurance, history safety, Grammar 8 and CLI Contract 9 behavior until an accepted public-contract decision changes them. Multi-file and nested composition from Issue #3, a generic related relationship, editor or MCP mutation, release selection, publication, remote writes, Issue mutation, and plan advance remain separate decisions."
  as_of 2026-08-24
  duration_unit point
  velocity 29p/2d
  finish PLANNING_POOL_ACCEPTED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1



resource DEVELOPERS:
  title "Implementation capacity"
  description "Two implementation slices may run concurrently only when their complete source and mutation surfaces do not overlap."
  capacity 2

resource REVIEWERS:
  title "Contract and acceptance review capacity"
  description "Serialize the normative contract, compatibility boundary, and final acceptance."
  capacity 1

resource LANGUAGE_SURFACE:
  title "Grammar and source ownership"
  description "Own declarations, qualified identity, source spans, validation, formatting, and migration."
  capacity 1

resource SEMANTIC_MODEL:
  title "Planning semantic model ownership"
  description "Own Work, AoA, association, dependency, order, projection-link, and lifecycle-independent observation semantics."
  capacity 1

resource RESHAPE_SURFACE:
  title "Semantic reshape and projection ownership"
  description "Own before and after inventories, conservation, residual meaning, projection, deferral, and archival candidates."
  capacity 1

resource MUTATION_SURFACE:
  title "Governed mutation ownership"
  description "Own preview binding, preflight hash and token, authority composition, safe writes, and history-loss checks."
  capacity 1

resource OBSERVATION_MODEL:
  title "Work and Window observation ownership"
  description "Own independent evidence axes, unique-identity aggregates, overlap, non-exclusive contribution, and unknown handling."
  capacity 1

resource HISTORY_SURFACE:
  title "Bounded historical evidence ownership"
  description "Own first-parent Git evidence, contraction lineage, continuity gaps, races, and hard limits."
  capacity 1

resource CLI_SURFACE:
  title "CLI and result-contract ownership"
  description "Own commands, request and result identities, schemas, diagnostics, Help, Guide, and public compatibility."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and integration ownership"
  description "Own public exports, installed-package behavior, adapter compatibility, and cross-surface acceptance."
  capacity 1










milestone PLANNING_POOL_ACCEPTED:
  title "Planning pool and bounded Windows accepted"
  state reached
milestone_criterion_set PLANNING_POOL_ACCEPTANCE_R1:
  milestone PLANNING_POOL_ACCEPTED
  revision R1
  commitment sha256:77ed59c27ec5556c5ae1de437488663fd04c1b2671c34edeef3ce6369faedfe9
  criterion END_TO_END_ACCEPTED required artifact "Accepted Planning Pool and bounded Windows end to end"

milestone_acceptance_receipt PLANNING_POOL_ACCEPTANCE_EVIDENCE:
  model 1
  set PLANNING_POOL_ACCEPTANCE_R1
  set_commitment sha256:77ed59c27ec5556c5ae1de437488663fd04c1b2671c34edeef3ce6369faedfe9
  criterion END_TO_END_ACCEPTED
  criterion_commitment sha256:92d26a78ee549cbc91d10b593ef207fc308b14f7244feef1ed5cef375e99f195
  action verify
  evidence_kind artifact
  evidence_reference "docs/process/planning-pool-acceptance.md"
  evidence_revision 9f187d044dbeb95b9a25374bfd6d7e19dc35422f
  verifier codex
  occurred_at 2026-08-25T08:42:03Z

