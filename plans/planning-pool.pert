# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project PLANNING_POOL:
  version 7
  title "Work-centered planning pool and bounded Windows"
  description "Implement PLAN-POOL-001 and Issue #12 as an independent single-document Work-centered planning workstream. First accept one normative contract for Work, project-owned Event and Activity AoA, active persisted and ad hoc Windows, semantic reshape, ownership-transfer projection, narrow deferral, observation, archival, and bounded Git reconstruction. Then implement source semantics, governed mutations, read models, history composition, the public CLI contract, and complete acceptance. Preserve the current strict DAG, one project finish, Task actuals and velocity, Milestone outcome acceptance, governance, plan assurance, history safety, Grammar 8 and CLI Contract 9 behavior until an accepted public-contract decision changes them. Multi-file and nested composition from Issue #3, a generic related relationship, editor or MCP mutation, release selection, publication, remote writes, Issue mutation, and plan advance remain separate decisions."
  as_of 2026-08-24
  duration_unit point
  velocity 29p/2d
  finish PLANNING_POOL_ACCEPTED
  goal_owner user
  dag_owner user
  plan_assurance_model 1
  plan_assurance_hash_model 1



resource DEVELOPERS:
  title "Implementation capacity"
  description "Two implementation slices may run concurrently only when their complete source and mutation surfaces do not overlap."
  capacity 2

resource REVIEWERS:
  title "Contract and acceptance review capacity"
  description "Serialize the normative contract, compatibility boundary, and final acceptance."
  capacity 1

resource LANGUAGE_SURFACE:
  title "Grammar and source ownership"
  description "Own declarations, qualified identity, source spans, validation, formatting, and migration."
  capacity 1

resource SEMANTIC_MODEL:
  title "Planning semantic model ownership"
  description "Own Work, AoA, association, dependency, order, projection-link, and lifecycle-independent observation semantics."
  capacity 1

resource RESHAPE_SURFACE:
  title "Semantic reshape and projection ownership"
  description "Own before and after inventories, conservation, residual meaning, projection, deferral, and archival candidates."
  capacity 1

resource MUTATION_SURFACE:
  title "Governed mutation ownership"
  description "Own preview binding, preflight hash and token, authority composition, safe writes, and history-loss checks."
  capacity 1

resource OBSERVATION_MODEL:
  title "Work and Window observation ownership"
  description "Own independent evidence axes, unique-identity aggregates, overlap, non-exclusive contribution, and unknown handling."
  capacity 1

resource HISTORY_SURFACE:
  title "Bounded historical evidence ownership"
  description "Own first-parent Git evidence, contraction lineage, continuity gaps, races, and hard limits."
  capacity 1

resource CLI_SURFACE:
  title "CLI and result-contract ownership"
  description "Own commands, request and result identities, schemas, diagnostics, Help, Guide, and public compatibility."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and integration ownership"
  description "Own public exports, installed-package behavior, adapter compatibility, and cross-surface acceptance."
  capacity 1


milestone PLANNING_POOL_SOURCE_READY:
  title "Planning source model ready"
  state reached

milestone PLANNING_POOL_RESHAPE_READY:
  title "Semantic reshape preflight ready"

milestone PLANNING_POOL_PROJECTION_READY:
  title "Projection and deferral ready"

milestone PLANNING_POOL_WINDOW_READY:
  title "Window mutation model ready"

milestone PLANNING_POOL_OBSERVATION_INPUT:
  title "Planning observation inputs ready"

milestone PLANNING_POOL_OBSERVATION_READY:
  title "Work and Window observations ready"

milestone PLANNING_POOL_HISTORY_READY:
  title "Historical planning observations ready"

milestone PLANNING_POOL_PUBLIC_READY:
  title "Public planning-pool contract ready"

milestone PLANNING_POOL_ACCEPTED:
  title "Planning pool and bounded Windows accepted"



task PLANNING_POOL_RESHAPE_CORE PLANNING_POOL_SOURCE_READY -> PLANNING_POOL_RESHAPE_READY:
  title "Implement semantic reshape and preflight navigation"
  description "Implement one atomic Work-boundary reshape model over complete labeled origins and Work or discard destinations. Return normalized before and after decompositions, actual descriptions, conservation and reference checks, exact candidate and source bindings, preflight hash, and a perttool-issued one-time opaque token. Require exact hash and token rebinding for execution, invalidate stale candidates, keep LLM self-audit unrecorded, make the later user-response boundary conspicuous, and retain ordinary governance and safe-write authority without OS-user authentication claims."
  duration 10p
  status done
  priority 90
  requires:
    DEVELOPERS 1
    SEMANTIC_MODEL 1
    RESHAPE_SURFACE 1
    MUTATION_SURFACE 1
  source "Issue #12"

task PLANNING_POOL_PROJECTION_CORE PLANNING_POOL_RESHAPE_READY -> PLANNING_POOL_PROJECTION_READY:
  title "Implement projection, contraction, and narrow deferral"
  description "Implement global project-owned Event-to-Milestone and Activity-to-Task ownership transfer with same identity, complete affected-Work links, closed Activity endpoints, residual-description reminder, explicit dependency disposition, last-consumer handling, Work and link archival, and history-safe final candidates. Add only the accepted reverse deferral for closed unstarted linked fragments, preserve boundary Milestones and the remaining strict DAG, and reject protected, actual-bearing, accepted, ambiguous, or retroactively split execution and outcome evidence."
  duration 10p
  priority 85
  requires:
    DEVELOPERS 1
    SEMANTIC_MODEL 1
    RESHAPE_SURFACE 1
    MUTATION_SURFACE 1
  source "Issue #12"

task PLANNING_POOL_WINDOW_CORE PLANNING_POOL_SOURCE_READY -> PLANNING_POOL_WINDOW_READY:
  title "Implement active Window mutations and contraction"
  description "Implement persisted and ad hoc Window construction, unique many-to-many Work membership, optional half-open comparable bounds, required persisted outcome-oriented objective, global-order filtering, overlap and dependency coverage, explicit close, optional next-Window carry-over, and history-protected source contraction. Keep Window operation independent from Work meaning, projection, Task scheduling, Milestone acceptance and wall-clock lifecycle triggers."
  duration 7p
  priority 82
  requires:
    DEVELOPERS 1
    SEMANTIC_MODEL 1
    MUTATION_SURFACE 1
  source "Issue #12"

gate PLANNING_POOL_PROJECTION_INPUT PLANNING_POOL_PROJECTION_READY -> PLANNING_POOL_OBSERVATION_INPUT:
  reason "Work and Window observations require accepted projection and deferral semantics"

gate PLANNING_POOL_WINDOW_INPUT PLANNING_POOL_WINDOW_READY -> PLANNING_POOL_OBSERVATION_INPUT:
  reason "Work and Window observations require accepted active Window mutation semantics"

task PLANNING_POOL_OBSERVATION_CORE PLANNING_POOL_OBSERVATION_INPUT -> PLANNING_POOL_OBSERVATION_READY:
  title "Implement Work and Window observations"
  description "Implement independent refinement, execution, outcome, organization, archiveability, temporal-position, overlap, dependency-coverage and close-disposition observations over exact source bindings. Show complete authoritative shared Task and Milestone facts to every linked Work, aggregate fully qualified identities once, mark selected-and-unselected contributions non-exclusive, preserve membership occurrences separately, and report absent, incomplete or unavailable evidence without Work completion or Window-objective achievement states."
  duration 8p
  priority 75
  requires:
    DEVELOPERS 1
    SEMANTIC_MODEL 1
    OBSERVATION_MODEL 1
  source "Issue #12"

task PLANNING_POOL_HISTORY_CORE PLANNING_POOL_OBSERVATION_READY -> PLANNING_POOL_HISTORY_READY:
  title "Implement bounded historical planning observations"
  description "Compose the accepted current-source observation model with bounded immutable first-parent Git evidence to reconstruct removed Work, projection-link, Task, Milestone, Window and close lineage after contraction or canonical advance. Bind repository, endpoint, blob and source identities, preserve exact latest-source authority, expose gaps, shallow and forced-loss boundaries, invalid history, races and hard limits, and retain no tombstone, completion snapshot, closed Window or durable close report in current source."
  duration 7p
  priority 70
  requires:
    DEVELOPERS 1
    OBSERVATION_MODEL 1
    HISTORY_SURFACE 1
  source "Issue #12"

task PLANNING_POOL_PUBLIC_CONTRACT PLANNING_POOL_HISTORY_READY -> PLANNING_POOL_PUBLIC_READY:
  title "Activate the public planning-pool contract"
  description "Atomically activate the accepted grammar and CLI-contract decision, commands, typed requests, immutable results, schemas, diagnostics, Help, Guide, library and Node exports, Application composition, installed-package behavior, migration and compatibility. Bind every mutation to preview, source digest, governance, plan assurance and safe persistence; keep editor and MCP mutation unavailable and preserve existing strict-DAG command meanings."
  duration 8p
  priority 65
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    LANGUAGE_SURFACE 1
    MUTATION_SURFACE 1
    CLI_SURFACE 1
    PACKAGE_SURFACE 1
  source "Issue #12"

task PLANNING_POOL_ACCEPTANCE PLANNING_POOL_PUBLIC_READY -> PLANNING_POOL_ACCEPTED:
  title "Accept planning pool and bounded Windows end to end"
  description "Trace every normative case through portable Core, governed preview and write, token rebinding, source contraction, Git history, public CLI and schemas, Help and Guide, temporary link and isolated packages. Exercise incomplete Draft use, backlog refinement into AoA, global shared projection, split and merge, dependency disposition, Scrum-like and Kanban-like Windows, close and carry-over, shared actual and outcome deduplication, direct strict-DAG use, narrow deferral, advance cleanup, gaps and races. Prove current strict DAG, actual, velocity, acceptance, assurance, governance and history meanings remain compatible and perform no release, publication, remote, Issue, editor, MCP or plan-advance mutation."
  duration 7p
  priority 60
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    LANGUAGE_SURFACE 1
    SEMANTIC_MODEL 1
    RESHAPE_SURFACE 1
    MUTATION_SURFACE 1
    OBSERVATION_MODEL 1
    HISTORY_SURFACE 1
    CLI_SURFACE 1
    PACKAGE_SURFACE 1
  source "Issue #12"

