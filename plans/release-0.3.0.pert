project RELEASE_030:
  version 1
  title "perttool 0.3.0 Contract 4 beta release"
  description "Release suffix-free 0.3.0 beta from the accepted atomic Contract 4 source and one verified tarball. RELEASE_030_GATE_DESIGN is complete and advanced. The scheduling-and-units macro and SU-M5 detail reached their accepted finishes, and RELEASE_030_CONTRACT_4_READINESS verified the complete public and installed boundary. Four tasks and 14p remain; precedence and heuristic resource makespans are both 14p with an inherited 28/17d forecast. Complete NextResult v4 recommends RELEASE_030_PREPARATION. Work is authorized through PUBLISH: clean Git push, annotated v0.3.0, GitHub prerelease, and npm beta. npm latest promotion and RELEASE_030_ACCEPTANCE remain outside that authorization."
  as_of 2026-07-26
  duration_unit point
  velocity 17p/2d
  finish RELEASE_030_ACCEPTED


resource DEVELOPERS:
  title "Release engineering capacity"
  capacity 2

resource REVIEWERS:
  title "Release and safety review capacity"
  description "Serialize scope, contract, candidate, external mutation, and acceptance decisions."
  capacity 1

resource RELEASE_SURFACE:
  title "Version and release-document ownership"
  description "Serialize package identity, CHANGELOG, procedure, migration guidance, and acceptance records."
  capacity 1

resource PACKAGE_SURFACE:
  title "Package and distribution ownership"
  description "Serialize package checks, tarball creation, and installed-package verification."
  capacity 1

resource EXTERNAL_RELEASE:
  title "Authorized external release mutation"
  description "Serialize Git push, annotated tag, GitHub Release, npm beta publication, and durable verification."
  capacity 1


milestone RELEASE_030_CONTRACT_4_READY:
  title "Accepted Contract 4 release input verified"
  state reached

milestone RELEASE_030_SOURCE_PREPARED:
  title "Version 0.3.0 release source prepared"

milestone RELEASE_030_CANDIDATE_ACCEPTED:
  title "Version 0.3.0 release candidate accepted"

milestone RELEASE_030_PUBLISHED:
  title "Version 0.3.0 published to GitHub and npm beta"

milestone RELEASE_030_ACCEPTED:
  title "Version 0.3.0 Contract 4 beta accepted"



task RELEASE_030_PREPARATION RELEASE_030_CONTRACT_4_READY -> RELEASE_030_SOURCE_PREPARED:
  title "Prepare version 0.3.0 release source"
  description "Align package and lockfile identity, CLI version, CHANGELOG, README, release documentation, golden artifacts, and generic beta publication validation. Run the complete repository and package gates without remote or registry writes."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1

task RELEASE_030_CANDIDATE RELEASE_030_SOURCE_PREPARED -> RELEASE_030_CANDIDATE_ACCEPTED:
  title "Accept one clean 0.3.0 release candidate"
  description "Review the complete intended release diff, commit it, run Node.js 22 acceptance, prove version and tag availability, verify current npm dist-tags and authenticated routes without exposing credentials, and accept one clean immutable release candidate. This task performs no external write."
  duration 4p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1

task RELEASE_030_PUBLISH RELEASE_030_CANDIDATE_ACCEPTED -> RELEASE_030_PUBLISHED:
  title "Publish version 0.3.0 from one tarball"
  description "Under the user's explicit authorization, push the clean release commit, create and verify annotated v0.3.0, generate one tarball outside the worktree, publish a GitHub prerelease with that artifact and SHA256SUMS, install and verify the GitHub asset, publish the identical tarball exactly once to npm beta through secdat, and verify beta=0.3.0 while latest remains unchanged."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    PACKAGE_SURFACE 1
    EXTERNAL_RELEASE 1

task RELEASE_030_ACCEPTANCE RELEASE_030_PUBLISHED -> RELEASE_030_ACCEPTED:
  title "Record durable 0.3.0 beta acceptance"
  description "Verify release commit and peeled tag identity, common local/GitHub/npm tarball digest, registry integrity and metadata, isolated installation from both public channels, complete Contract 4 behavior, beta and unchanged latest tags, and exact commands. Record a post-release acceptance document without altering the immutable artifact."
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    RELEASE_SURFACE 1
    PACKAGE_SURFACE 1
