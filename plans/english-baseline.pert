project ENGLISH_BASELINE:
  version 1
  title "English repository baseline migration"
  description "Record the accepted English repository baseline adopted by ADR 0004. The canonical surface inventory, exact Unicode allowlist boundary, and final cross-surface acceptance are recorded in docs/process/english-surface-inventory.md and docs/process/english-baseline-acceptance.md. All planned migration and acceptance work is complete. Runtime i18n, translation catalogs, locale negotiation, and translation of user-authored content remain outside this plan."
  as_of 2026-07-29
  duration_unit point
  velocity 42p/2d
  finish ENGLISH_BASELINE_ACCEPTED

resource DEVELOPERS:
  title "Implementation capacity"
  capacity 2

resource REVIEWERS:
  title "Normative meaning and compatibility review capacity"
  description "Only one normative language or public-contract review runs at a time"
  capacity 1

resource CLI_SURFACE:
  title "CLI, help, and diagnostic surface ownership"
  description "Avoid concurrent changes to shared public message and help surfaces"
  capacity 1

resource DOC_SURFACE:
  title "Normative and process documentation ownership"
  description "Avoid concurrent structural edits to shared documentation indexes and links"
  capacity 1










milestone ENGLISH_BASELINE_ACCEPTED:
  title "English repository baseline accepted"
  state reached
