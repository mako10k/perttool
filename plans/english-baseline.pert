project ENGLISH_BASELINE:
  version 1
  title "English repository baseline migration"
  description "Migrate repository-maintained prose, bundled help, and diagnostics to the English baseline adopted by ADR 0004. The canonical surface inventory and Unicode allowlist are recorded in docs/process/english-surface-inventory.md. Remaining migration work is tracked by the current tasks. Runtime i18n, translation catalogs, locale negotiation, and translation of user-authored content remain outside this plan."
  as_of 2026-07-24
  duration_unit point
  velocity 28p/1d
  finish ENGLISH_BASELINE_ACCEPTED

resource DEVELOPERS:
  title "Implementation capacity"
  capacity 2

resource REVIEWERS:
  title "Normative meaning and compatibility review capacity"
  description "Only one normative language or public-contract review runs at a time"
  capacity 1

resource CLI_SURFACE:
  title "CLI, help, and diagnostic surface ownership"
  description "Avoid concurrent changes to shared public message and help surfaces"
  capacity 1

resource DOC_SURFACE:
  title "Normative and process documentation ownership"
  description "Avoid concurrent structural edits to shared documentation indexes and links"
  capacity 1


milestone SURFACE_INVENTORY_READY:
  title "Migration inventory and allowlist design ready"
  state reached

milestone RUNTIME_MESSAGES_READY:
  title "Runtime messages migrated"
  state reached

milestone HELP_AND_USAGE_READY:
  title "Bundled help and usage migrated"


milestone PROCESS_GUIDANCE_READY:
  title "Process and agent guidance migrated"
  state reached

milestone PERT_PLANS_READY:
  title "Current PERT plans migrated"

milestone ENGLISH_CONTENT_READY:
  title "Canonical English content slices complete"

milestone GOLDEN_UNICODE_READY:
  title "Golden and Unicode audit complete"

milestone ENGLISH_BASELINE_ACCEPTED:
  title "English repository baseline accepted"


task HELP_AND_USAGE SURFACE_INVENTORY_READY -> HELP_AND_USAGE_READY:
  title "Migrate bundled help and usage text to English"
  description |
    Translate dsl help, structured command help, examples embedded in help,
    usage diagnostics, and related golden files. Preserve command names, DSL
    keywords, exit status, machine-readable capability data, and installed
    package parity.
  duration 5p
  priority 95
  requires:
    DEVELOPERS 1
    CLI_SURFACE 1



task PERT_PLANS SURFACE_INVENTORY_READY -> PERT_PLANS_READY:
  title "Migrate current PERT plan metadata to English"
  description |
    Translate current and future project, resource, milestone, task, gate, and
    evidence prose without changing IDs, topology, estimates, state, priority,
    or resource requirements. Do not reconstruct completed history from Git.
  duration 3p
  priority 80
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    DOC_SURFACE 1

gate RUNTIME_CONTENT_GATE RUNTIME_MESSAGES_READY -> ENGLISH_CONTENT_READY:
  reason "English acceptance requires runtime messages"

gate HELP_CONTENT_GATE HELP_AND_USAGE_READY -> ENGLISH_CONTENT_READY:
  reason "English acceptance requires bundled help and usage"

gate PROCESS_CONTENT_GATE PROCESS_GUIDANCE_READY -> ENGLISH_CONTENT_READY:
  reason "English acceptance requires normative and process documentation"

gate PLAN_CONTENT_GATE PERT_PLANS_READY -> ENGLISH_CONTENT_READY:
  reason "English acceptance requires current PERT plans"

task GOLDEN_UNICODE_AUDIT ENGLISH_CONTENT_READY -> GOLDEN_UNICODE_READY:
  title "Audit golden files and preserve intentional Unicode coverage"
  description |
    Update translated byte and JSON golden files, add a repository-local
    Japanese-script check for canonical surfaces, and allowlist only explicit
    user-authored, interoperability, or Unicode round-trip fixtures. Verify that
    stable identifiers and structured data remain unchanged.
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
    CLI_SURFACE 1

task ENGLISH_ACCEPTANCE GOLDEN_UNICODE_READY -> ENGLISH_BASELINE_ACCEPTED:
  title "Accept the English repository baseline"
  description |
    Trace ADR 0004 through requirements, design, runtime, help, documentation,
    plans, tests, package contents, and agent entrypoints. Run the full
    repository, link, package, documentation, and language-surface checks.
    Confirm that no runtime locale negotiation or translation catalog was added.
  duration 3p
  priority 100
  requires:
    DEVELOPERS 1
    REVIEWERS 1
