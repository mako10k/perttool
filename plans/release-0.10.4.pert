# Existing .pert plans should normally be maintained through perttool commands; direct DSL editing bypasses goal/DAG owner-confirmation checks.
project RELEASE_0104:
  version 7
  title "perttool 0.10.4 explicit history provenance patch release"
  description "Release the accepted Issue #6 correction as suffix-free 0.10.4 while preserving Grammar 8, CLI Contract 9, public identities, automatic fail-closed behavior, and Git authority boundaries. npm latest, public VSIX publication, plan advance, SCM-002, and unrelated work remain separate."
  as_of 2026-08-21
  duration_unit point
  finish RELEASE_0104_ACCEPTED


milestone_acceptance_migration GRAMMAR_7_BASELINE:
  model 1
  repository git:sha1:24d0aea0bf0b8e6448dbb9b9bb849acf42d96060:index:5652dfa9145584d50780c9dabdace1e8c85d9782
  path "plans/release-0.10.4.pert"
  object_format sha1
  head 24d0aea0bf0b8e6448dbb9b9bb849acf42d96060
  blob 5652dfa9145584d50780c9dabdace1e8c85d9782
