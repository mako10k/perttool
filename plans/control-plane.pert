project AI_CONTROL_PLANE_DESIGN:
  version 1
  title "AI Project Control Plane design"
  description |
    Turn GitHub Issue #1 into a deterministic and explainable task-recommendation contract that separates execution eligibility from recommendation strength. This plan covers design only and excludes implementation.
    Points retain the relative estimates from the start of design; the end-to-end forecast after adding the structured explanation model is 13p.
    Velocity was recalibrated to the measured 16p/1d from nine tasks completed on 2026-07-22.
    DESIGN_REVIEW was incomplete at the calibration point and was excluded to avoid a cycle; its completed result is deferred to the next calibration sample.
  as_of 2026-07-22
  duration_unit point
  velocity 16p/1d
  finish CONTROL_PLANE_DESIGN_ACCEPTED

resource DESIGNERS:
  title "Requirements and specification design capacity"
  capacity 2

resource REVIEWERS:
  title "Design acceptance review capacity"
  capacity 1

milestone NOW:
  title "Issue #1 filed"
  state reached

milestone VISION_DEFINED:
  title "Product vision and design boundary defined"

milestone RECOMMENDATION_MODEL_DEFINED:
  title "Execution eligibility and recommendation model defined"

milestone RANKING_POLICY_DEFINED:
  title "Deterministic ranking policy defined"

milestone REASON_CODES_DEFINED:
  title "Stable reason codes defined"

milestone EXPLANATION_INPUT_READY:
  title "Structured-explanation design input ready"

milestone STRUCTURED_EXPLANATION_DEFINED:
  title "Structured reason descriptions and decision traces defined"

milestone CONTRACT_INPUT_READY:
  title "Interface design input ready"

milestone INTERFACE_CONTRACT_DEFINED:
  title "Text and JSON interface contract defined"

milestone OVERRIDE_CONTRACT_DEFINED:
  title "Human override contract defined"

milestone VALIDATION_INPUT_READY:
  title "Example and migration design input ready"

milestone NORMATIVE_EXAMPLES_DEFINED:
  title "Normative examples and test perspectives defined"

milestone PROCESS_MIGRATION_DEFINED:
  title "Self-use and migration policy defined"

milestone DESIGN_REVIEW_READY:
  title "Design ready for acceptance review"

milestone CONTROL_PLANE_DESIGN_ACCEPTED:
  title "Issue #1 design complete"

task VISION_REQUIREMENTS NOW -> VISION_DEFINED:
  title "Define the purpose and boundary of the AI Project Control Plane"
  description "Define the source of truth, global objective, determinism, and non-goals in the requirements"
  duration 2p
  status done
  priority 100
  requires:
    DESIGNERS 1

task RECOMMENDATION_MODEL VISION_DEFINED -> RECOMMENDATION_MODEL_DEFINED:
  title "Define the execution-eligibility and recommendation model"
  description "Separate lifecycle and eligibility, resource selection, and recommendation tiers; fix each tier's formal meaning and the requirement for structured explanations"
  duration 2p
  status done
  priority 90
  requires:
    DESIGNERS 1

task RANKING_POLICY RECOMMENDATION_MODEL_DEFINED -> RANKING_POLICY_DEFINED:
  title "Define a deterministic ranking policy"
  description "Fix precedence rules for criticality, float, priority, unlocks, gate and milestone distance, and resources, plus a complete tie-break and a trace of winners, alternatives, and decision rules"
  duration 2p
  status done
  priority 80
  requires:
    DESIGNERS 1

task REASON_CODE_TAXONOMY RECOMMENDATION_MODEL_DEFINED -> REASON_CODES_DEFINED:
  title "Define the stable reason-code taxonomy"
  description "Fix the trigger condition and polarity of each code and the treatment of related facts and unmodeled information"
  duration 2p
  status done
  priority 80
  requires:
    DESIGNERS 1

task HUMAN_OVERRIDE_CONTRACT RECOMMENDATION_MODEL_DEFINED -> OVERRIDE_CONTRACT_DEFINED:
  title "Define human override semantics and audit policy"
  description "Design only the override reason and reanalysis contract; do not implement a write command"
  duration 1p
  status done
  priority 60
  requires:
    DESIGNERS 1

gate RANKING_EXPLANATION_INPUT RANKING_POLICY_DEFINED -> EXPLANATION_INPUT_READY:
  reason "A structured decision trace requires the ranking policy"

gate REASON_EXPLANATION_INPUT REASON_CODES_DEFINED -> EXPLANATION_INPUT_READY:
  reason "Structured reason descriptions require the reason-code taxonomy"

task STRUCTURED_EXPLANATION_MODEL EXPLANATION_INPUT_READY -> STRUCTURED_EXPLANATION_DEFINED:
  title "Define structured reason descriptions and decision traces"
  description "Fix typed facts, a restricted expression AST, comparisons, decisive and supporting roles, and description keys and parameters; make natural-language text a derived projection"
  duration 2p
  status done
  priority 75
  requires:
    DESIGNERS 1

gate EXPLANATION_CONTRACT_INPUT STRUCTURED_EXPLANATION_DEFINED -> CONTRACT_INPUT_READY:
  reason "The interface contract requires the structured-explanation model"

task INTERFACE_CONTRACT CONTRACT_INPUT_READY -> INTERFACE_CONTRACT_DEFINED:
  title "Define the Core, text, and JSON recommendation contract"
  description "Fix schema migration, algorithm versions, higher-priority references, decision traces, description projection, and adapter responsibilities"
  duration 2p
  status done
  priority 70
  requires:
    DESIGNERS 1

gate INTERFACE_VALIDATION_INPUT INTERFACE_CONTRACT_DEFINED -> VALIDATION_INPUT_READY:
  reason "Normative examples and migration require the interface contract"

gate OVERRIDE_VALIDATION_INPUT OVERRIDE_CONTRACT_DEFINED -> VALIDATION_INPUT_READY:
  reason "Normative examples and migration require the override contract"

task NORMATIVE_EXAMPLES VALIDATION_INPUT_READY -> NORMATIVE_EXAMPLES_DEFINED:
  title "Define normative conflict examples and test perspectives"
  description "Cover criticality versus priority, resource conflicts, parallel recommendations, proximity to a gate, all-blocked input, and a decision trace explaining why A rather than B"
  duration 2p
  status done
  priority 50
  requires:
    DESIGNERS 1

task PROCESS_MIGRATION VALIDATION_INPUT_READY -> PROCESS_MIGRATION_DEFINED:
  title "Design the self-use flow and implementation migration order"
  description "Align the basic design and AI process, then decompose the work finely enough to reconstruct an implementation plan after design"
  duration 1p
  status done
  priority 40
  requires:
    DESIGNERS 1

gate EXAMPLES_REVIEW_INPUT NORMATIVE_EXAMPLES_DEFINED -> DESIGN_REVIEW_READY:
  reason "Design acceptance requires normative examples"

gate PROCESS_REVIEW_INPUT PROCESS_MIGRATION_DEFINED -> DESIGN_REVIEW_READY:
  reason "Design acceptance requires the self-use and migration policy"

task DESIGN_REVIEW DESIGN_REVIEW_READY -> CONTROL_PLANE_DESIGN_ACCEPTED:
  title "Review the Issue #1 design completion criteria across all surfaces"
  description "Confirm consistency across requirements, specifications, design, examples, process, and interfaces"
  duration 1p
  status done
  priority 30
  requires:
    DESIGNERS 1
    REVIEWERS 1
