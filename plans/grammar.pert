project GRAMMAR:
  version 1
  title "DSL grammar acceptance work"
  description |
    Parser, formatter, and help-synchronization acceptance is complete.
    Done tasks remain until the advance write gate is satisfied; use Git history for the past.
    Points retain relative scale, and day forecasts use the measured velocity from the two most recently completed tasks on 2026-07-22: 3p over one active day.
  as_of 2026-07-22
  duration_unit point
  velocity 3p/1d
  finish GRAMMAR_READY

resource DEVELOPERS:
  title "Implementation capacity"
  capacity 2

resource GRAMMAR_REVIEW:
  title "Grammar review capacity"
  description "Only one acceptance-fixture decision runs at a time"
  capacity 1

milestone NOW:
  title "Current state"
  state reached

milestone FIELDS_VERIFIED:
  title "All fields accepted"

milestone RECOVERY_VERIFIED:
  title "Error recovery accepted"

milestone TEXT_SPANS_VERIFIED:
  title "Block text and source spans accepted"

milestone PARSER_ACCEPTED:
  title "Parser accepted"

milestone FORMATTER_IMPLEMENTED:
  title "Formatter implemented"

milestone FORMATTER_ACCEPTED:
  title "Formatter accepted"

milestone HELP_SYNCHRONIZED:
  title "Help and fixtures synchronized"

milestone GRAMMAR_READY:
  title "Grammar slice complete"

task FIELD_FIXTURES NOW -> FIELDS_VERIFIED:
  title "Cover every declaration field and invalid token with fixtures"
  duration 2p
  status done
  priority 30
  requires:
    DEVELOPERS 1
    GRAMMAR_REVIEW 1

task ERROR_RECOVERY NOW -> RECOVERY_VERIFIED:
  title "Verify multiple-error recovery and diagnostic suppression"
  duration 3p
  status done
  priority 40
  requires:
    DEVELOPERS 1
    GRAMMAR_REVIEW 1

task BLOCK_TEXT_SPANS NOW -> TEXT_SPANS_VERIFIED:
  title "Verify common indentation and UTF-16 spans for block text"
  duration 2p
  status done
  priority 20
  requires:
    DEVELOPERS 1

gate FIELDS_ACCEPTANCE FIELDS_VERIFIED -> PARSER_ACCEPTED:
  reason "Acceptance of every field is required"

gate RECOVERY_ACCEPTANCE RECOVERY_VERIFIED -> PARSER_ACCEPTED:
  reason "Acceptance of error recovery is required"

gate TEXT_SPANS_ACCEPTANCE TEXT_SPANS_VERIFIED -> PARSER_ACCEPTED:
  reason "Acceptance of block text and source spans is required"

task FORMATTER_IMPLEMENT PARSER_ACCEPTED -> FORMATTER_IMPLEMENTED:
  title "Implement the source-preserving formatter"
  duration 3p
  status done
  priority 20
  requires:
    DEVELOPERS 1

task HELP_FIXTURE_SYNC PARSER_ACCEPTED -> HELP_SYNCHRONIZED:
  title "Detect drift between syntax help samples and parser fixtures"
  duration 1p
  status done
  priority 10
  requires:
    DEVELOPERS 1
    GRAMMAR_REVIEW 1

task FORMATTER_ROUNDTRIP FORMATTER_IMPLEMENTED -> FORMATTER_ACCEPTED:
  title "Verify formatter idempotence and AST equivalence with goldens"
  duration 2p
  status done
  priority 30
  requires:
    DEVELOPERS 1
    GRAMMAR_REVIEW 1

gate FORMATTER_READY FORMATTER_ACCEPTED -> GRAMMAR_READY:
  reason "Formatter acceptance is required"

gate HELP_READY HELP_SYNCHRONIZED -> GRAMMAR_READY:
  reason "Help and fixture synchronization is required"
