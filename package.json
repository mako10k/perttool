{
  "name": "perttool",
  "version": "0.5.0",
  "description": "Document-based PERT/CPM and resource scheduling CLI",
  "keywords": [
    "pert",
    "cpm",
    "dag",
    "task-management",
    "cli"
  ],
  "homepage": "https://github.com/mako10k/perttool#readme",
  "bugs": {
    "url": "https://github.com/mako10k/perttool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako10k/perttool.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "type": "module",
  "files": [
    "dist",
    "schemas",
    "CHANGELOG.md"
  ],
  "bin": {
    "perttool": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "npm run build && node --test test/e2e.test.mjs",
    "check:english": "node scripts/check-english-baseline.mjs",
    "check:docs": "bash scripts/check-docs.sh",
    "check:link": "bash scripts/check-npm-link.sh",
    "check:package": "bash scripts/check-package.sh",
    "check:self-use": "bash scripts/check-self-use.sh",
    "check": "npm run typecheck && npm test && npm run check:english && npm run check:docs && npm run check:self-use && npm run check:link && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "ajv": "^8.20.0",
    "typescript": "7.0.2"
  }
}
