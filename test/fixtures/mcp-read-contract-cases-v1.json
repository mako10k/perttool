{
  "schema_version": "Perttool.McpReadContractCases.v1",
  "mcp_protocol_model_version": 1,
  "protocol": {
    "revision": "2026-07-28",
    "sdk_package": "@modelcontextprotocol/server",
    "sdk_version": "2.0.0",
    "transport": "stdio",
    "node_engine": ">=22",
    "workspace": "adapters/mcp",
    "private_package": "perttool-mcp-private",
    "protocol_fallback": false,
    "network_listener": false,
    "child_cli": false
  },
  "capabilities": {
    "advertised": ["resources", "tools"],
    "resource_subscriptions": false,
    "resource_list_changed": false,
    "tool_list_changed": false,
    "resource_templates": false,
    "unavailable": ["prompts", "completions", "roots", "sampling", "elicitation", "tasks", "logging", "extensions"]
  },
  "resources": [
    {"uri": "perttool://capabilities", "name": "perttool capabilities", "result_schema": "Perttool.McpCapabilities.v1"},
    {"uri": "perttool://help/commands", "name": "perttool command help", "result_schema": "Perttool.CommandHelpResult.v1"},
    {"uri": "perttool://guide/index", "name": "perttool guide index", "result_schema": "Perttool.GuideResult.v1"},
    {"uri": "perttool://schemas", "name": "perttool schema catalog", "result_schema": "Perttool.SchemaResult.v1"}
  ],
  "source_selectors": {
    "inline": {
      "fields": ["kind", "text", "expected_digest"],
      "required": ["kind", "text"],
      "computed_digest": true
    },
    "registered": {
      "fields": ["kind", "document_id", "expected_digest"],
      "required": ["kind", "document_id", "expected_digest"],
      "launcher_only": true,
      "absolute_path_returned": false
    },
    "forbidden": ["path", "file_uri", "cwd", "glob", "workspace_root", "git_repository", "git_ref", "commit", "remote_url", "wire_registration"]
  },
  "tools": [
    {
      "name": "perttool_check",
      "operation": "document_check",
      "application_result_schema": "Perttool.CheckResult.v5",
      "mcp_result_schema": "Perttool.McpCheckResult.v1",
      "input_fields": ["source", "max_diagnostics"]
    },
    {
      "name": "perttool_analyze",
      "operation": "dag_analyze",
      "application_result_schema": "Perttool.AnalysisResult.v6",
      "mcp_result_schema": "Perttool.McpAnalyzeResult.v1",
      "input_fields": ["source", "schedule", "capacities", "max_paths", "precision", "max_diagnostics"]
    },
    {
      "name": "perttool_next",
      "operation": "dag_next",
      "application_result_schema": "Perttool.NextResult.v7",
      "mcp_result_schema": "Perttool.McpNextResult.v1",
      "input_fields": ["source", "capacities", "explain_depth", "precision", "max_diagnostics"]
    },
    {
      "name": "perttool_help",
      "operation": "command_help_or_guide",
      "application_result_schema": "Perttool.CommandHelpResult.v1|Perttool.GuideResult.v1",
      "mcp_result_schema": "Perttool.McpHelpResult.v1",
      "input_fields": ["kind", "resource", "action", "topic_id", "level"]
    },
    {
      "name": "perttool_schema",
      "operation": "schema_lookup",
      "application_result_schema": "Perttool.SchemaResult.v1",
      "mcp_result_schema": "Perttool.McpSchemaResult.v1",
      "input_fields": ["schema_id", "view", "ref"]
    }
  ],
  "tool_annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "limits": {
    "request_bytes": 262144,
    "source_bytes": 2097152,
    "output_bytes": 8388608,
    "registrations": 64,
    "capacity_overrides": 256,
    "concurrent_tools": 8,
    "wall_time_ms": 30000,
    "diagnostics_default": 100,
    "diagnostics_maximum": 1000,
    "max_paths_maximum": 1000,
    "explain_depth_maximum": 32,
    "precision_maximum": 9
  },
  "error_mapping": {
    "invalid_params": -32602,
    "method_not_found": -32601,
    "internal_error": -32603,
    "source_diagnostics": ["PTMCP-101", "PTMCP-102", "PTMCP-103", "PTMCP-104", "PTMCP-105", "PTMCP-106", "PTMCP-107", "PTMCP-108"],
    "domain_failure_is_tool_error": true,
    "partial_semantic_result": false
  },
  "forbidden_operations": ["format", "init", "set", "add", "remove", "start", "suspend", "resume", "finish", "batch", "migrate", "advance", "import", "export", "render", "override", "persist"],
  "cases": [
    {"id": "MCR-001", "depends_on": [], "boundary": "protocol_sdk_runtime"},
    {"id": "MCR-002", "depends_on": ["MCR-001"], "boundary": "stdio_lifecycle"},
    {"id": "MCR-003", "depends_on": ["MCR-002"], "boundary": "capability_discovery"},
    {"id": "MCR-004", "depends_on": ["MCR-003"], "boundary": "static_resources"},
    {"id": "MCR-005", "depends_on": ["MCR-003"], "boundary": "inline_source"},
    {"id": "MCR-006", "depends_on": ["MCR-005"], "boundary": "registered_source"},
    {"id": "MCR-007", "depends_on": ["MCR-006"], "boundary": "check_tool"},
    {"id": "MCR-008", "depends_on": ["MCR-006"], "boundary": "analyze_tool"},
    {"id": "MCR-009", "depends_on": ["MCR-006"], "boundary": "next_tool"},
    {"id": "MCR-010", "depends_on": ["MCR-003"], "boundary": "help_tool"},
    {"id": "MCR-011", "depends_on": ["MCR-003"], "boundary": "schema_tool"},
    {"id": "MCR-012", "depends_on": ["MCR-007", "MCR-008", "MCR-009", "MCR-010", "MCR-011"], "boundary": "closed_results"},
    {"id": "MCR-013", "depends_on": ["MCR-012"], "boundary": "diagnostic_and_error_ownership"},
    {"id": "MCR-014", "depends_on": ["MCR-002", "MCR-013"], "boundary": "limits_and_cancellation"},
    {"id": "MCR-015", "depends_on": ["MCR-012", "MCR-014"], "boundary": "cli_core_parity"},
    {"id": "MCR-016", "depends_on": ["MCR-004", "MCR-015"], "boundary": "read_only_side_effects"}
  ]
}
