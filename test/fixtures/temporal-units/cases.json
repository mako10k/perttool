      "expected": {
        "document_ok": true,
        "projection_state": "unavailable",
        "unavailable_causes": ["date_anchor_has_no_clock"],
        "rounded_or_promoted": false
      }
    },
    {
      "case_id": "TUE-008",
      "category": "deadline",
      "title": "Current deadline comparison is inclusive",
      "operation": "dag.analyze",
      "input": {
        "as_of": "2026-07-25",
        "deadlines": [
          "2026-07-26",
          "2026-07-25",
          "2026-07-24"
