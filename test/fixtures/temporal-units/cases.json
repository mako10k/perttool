    "unit_migration": {
      "id": "perttool.unit-migration",
      "version": 1
    }
  },
  "cases": [
    {
      "case_id": "TUE-001",
      "category": "validation",
      "title": "Grammar version 1 remains closed",
      "operation": "document.check",
      "input": {
        "project_version": 1,
        "field": "task.deadline",
        "literal": "2026-07-25"
      },
      "expected": {
        "ok": false,
        "diagnostic_codes": ["PTDSL-005"],
        "temporal_inputs": null
      }
    },
    {
      "case_id": "TUE-002",
      "category": "validation",
      "title": "A temporal field requires the explicit anchor",
      "operation": "document.check",
      "input": {
        "project_version": 2,
        "as_of": null,
        "field": "milestone.deadline",
        "literal": "2026-07-25"
      },
      "expected": {
        "ok": false,
        "diagnostic_codes": ["PTSEM-112"],
        "wall_clock_read": false,
        "host_zone_read": false
      }
    },
    {
      "case_id": "TUE-003",
      "category": "validation",
      "title": "Invalid Gregorian and date-time spellings fail as source errors",
      "operation": "document.check",
      "input": {
        "invalid_literals": [
          "2026-02-29",
          "2026-07-25T10:00:00",
          "2026-07-25T10:00:60Z"
        ]
      },
      "expected": {
        "ok": false,
        "diagnostic_code_by_literal": {
          "2026-02-29": "PTDSL-008",
          "2026-07-25T10:00:00": "PTDSL-008",
          "2026-07-25T10:00:60Z": "PTDSL-008"
        },
        "candidate": null
      }
    },
    {
