      "expected": {
        "base_unit_restored": "point",
        "exact_duration_values_restored": true,
        "semantic_velocity_restored": true,
        "non_timing_semantics_restored": true,
        "temporal_source_tokens_byte_equal": true,
        "original_token": "4.00p",
        "inverse_token": "4p",
        "whole_document_byte_equal": false,
        "reversibility": "exact"
