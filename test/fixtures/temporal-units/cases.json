        "resource": {
          "start": "2/1h",
          "finish": "4/1h",
          "forecast_relation": "after_deadline",
          "signed_margin": "-2/1h",
          "assessment": "heuristic_late",
          "optimal": false
        },
        "combined_assessment": "at_risk",
        "proof_of_infeasibility": false
      }
    },
    {
      "case_id": "TUE-010",
      "category": "deadline",
