    {
      "case_id": "TUE-012",
      "category": "migration",
      "title": "Point-to-day migration converts every inventoried field exactly",
      "operation": "project.migrate-unit",
      "fixture": "migration-point-v2.pert",
      "input": {
        "target_unit": "day",
        "replacement_velocity": null
      },
      "expected": {
        "ok": true,
        "changed": true,
        "source_unit": "point",
        "target_unit": "day",
        "effective_velocity": "20p/10d",
        "velocity_disposition": "retained",
        "converted_tokens_by_field": {
          "project.critical_epsilon": "0.25d",
          "project.target_duration": "6d",
          "task.FIXED.duration": "2d",
          "task.ESTIMATED.estimate.optimistic": "1d",
          "task.ESTIMATED.estimate.most_likely": "2d",
          "task.ESTIMATED.estimate.pessimistic": "3d"
        },
        "reversibility": "exact",
        "temporal_tokens_preserved": [
          "2026-07-25T09:00:00+09:00",
          "2026-07-27T09:00:00+09:00",
          "2026-07-30T09:00:00+09:00"
        ]
      }
    },
    {
      "case_id": "TUE-013",
      "category": "migration",
      "title": "Hour-to-point migration can insert an explicit velocity",
      "operation": "project.migrate-unit",
      "fixture": "migration-hour-v2.pert",
      "input": {
        "target_unit": "point",
        "replacement_velocity": "8p/4h"
      },
      "expected": {
        "ok": true,
        "changed": true,
        "source_unit": "hour",
        "target_unit": "point",
        "effective_velocity": "8p/4h",
        "velocity_disposition": "inserted",
        "converted_tokens_by_field": {
          "project.critical_epsilon": "1p",
          "project.target_duration": "8p",
          "task.FIXED.duration": "5p",
          "task.ESTIMATED.estimate.optimistic": "2p",
          "task.ESTIMATED.estimate.most_likely": "4p",
          "task.ESTIMATED.estimate.pessimistic": "6p"
        },
        "reversibility": "values_exact_metadata_changed",
        "temporal_tokens_preserved": true
      }
    },
    {
      "case_id": "TUE-014",
      "category": "migration",
      "title": "Unsupported directions and incompatible velocity fail explicitly",
      "operation": "project.migrate-unit",
