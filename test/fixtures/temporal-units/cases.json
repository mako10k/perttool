        "requests": [
          {
            "source_unit": "point",
            "target_unit": "hour",
            "velocity": "10p/5d"
          },
          {
            "source_unit": "day",
            "target_unit": "hour",
            "velocity": "10p/5d"
          },
          {
            "source_unit": "hour",
            "target_unit": "point",
            "velocity": "10p/5d"
          },
          {
            "source_unit": "hour",
            "target_unit": "hour",
            "replacement_velocity": "8p/4h"
          }
        ]
      },
      "expected": {
        "causes": [
          "velocity_period_mismatch",
          "unsupported_direction",
          "velocity_period_mismatch",
          "same_unit_velocity_change"
        ],
        "diagnostic_codes": [
          "PTMIG-405",
          "PTMIG-404",
          "PTMIG-405",
          "PTMIG-406"
        ],
        "partial_candidate_exposed": false
      }
    },
