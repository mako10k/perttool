      "case_id": "TUE-017",
      "category": "migration",
      "title": "The exact inverse restores values but not lexical padding",
      "operation": "project.migrate-unit",
      "fixture": "migration-point-v2.pert",
      "input": {
        "sequence": [
          {
            "target_unit": "day"
          },
          {
            "target_unit": "point"
          }
        ]
