      "expected": {
        "state_by_deadline": {
          "2026-07-26": "not_due",
          "2026-07-25": "due_now",
          "2026-07-24": "overdue"
        },
        "end_of_day_inferred": false
      }
    },
    {
      "case_id": "TUE-009",
      "category": "deadline",
      "title": "Resource lateness is at risk rather than proven infeasible",
      "operation": "dag.analyze",
