project APPROVAL_RELEASE:
  version 1
  title "guarded run"
  as_of 2026-07-21
  duration_unit day
  finish RELEASED

resource DEVELOPERS:
  title "staff"
  capacity 1

milestone NOW:
  title "T0"
  state reached

milestone SECURITY_APPROVED:
  title "Secured OK"

milestone IMPLEMENTED:
  title "Done"

milestone RELEASE_READY:
  title "Go now"

milestone RELEASED:
  title "Online"

task SECURITY_REVIEW NOW -> SECURITY_APPROVED:
  title "External check"
  duration 2d
  status blocked
  blocked_reason "Need firm"
  priority 30

task IMPLEMENT NOW -> IMPLEMENTED:
  title "Fix notes"
  duration 2d
  priority 20
  requires:
    DEVELOPERS 1

gate SECURITY_READY SECURITY_APPROVED -> RELEASE_READY:
  reason "Need OK"

gate IMPLEMENT_READY IMPLEMENTED -> RELEASE_READY:
  reason "Impl OK"

task RELEASE RELEASE_READY -> RELEASED:
  title "Deploy"
  duration 1d
