project RELEASE_CAPACITY:
  version 1
  title "team what-if"
  as_of 2026-07-21
  duration_unit day
  finish RELEASED

resource ENGINEERS:
  title "staff"
  capacity 1

milestone NOW:
  title "T0"
  state reached

milestone API_DONE:
  title "APIok"

milestone UI_DONE:
  title "UIok"

milestone RELEASE_READY:
  title "Go-ready"

milestone RELEASED:
  title "Online"

task API NOW -> API_DONE:
  title "Make API"
  duration 4d
  priority 20
  requires:
    ENGINEERS 1

task UI NOW -> UI_DONE:
  title "Make UI"
  duration 3d
  priority 10
  requires:
    ENGINEERS 1

gate API_READY API_DONE -> RELEASE_READY:
  reason "Need API"

gate UI_READY UI_DONE -> RELEASE_READY:
  reason "Need UI"

task RELEASE RELEASE_READY -> RELEASED:
  title "Deploy"
  duration 1d
