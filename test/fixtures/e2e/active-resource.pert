project LIVE_INCIDENT:
  version 1
  title "exclusive access"
  as_of 2026-07-21
  duration_unit day
  finish CLOSED

resource OPERATORS:
  title "staff"
  capacity 1

milestone NOW:
  title "T0"
  state reached

milestone MITIGATION_DONE:
  title "Stable"

milestone RUNBOOK_DONE:
  title "Runbook"

milestone UPDATE_DONE:
  title "Update"

milestone RESPONSE_READY:
  title "Open"

milestone CLOSED:
  title "Done"

task MITIGATE NOW -> MITIGATION_DONE:
  title "Stabilize"
  duration 2d
  status active
  priority 30
  requires:
    OPERATORS 1

task STATUS_UPDATE NOW -> UPDATE_DONE:
  title "Send update"
  duration 1d
  priority 20

task RUNBOOK NOW -> RUNBOOK_DONE:
  title "Edit docs"
  duration 1d
  priority 10
  requires:
    OPERATORS 1

gate MITIGATION_READY MITIGATION_DONE -> RESPONSE_READY:
  reason "Fix first"

gate RUNBOOK_READY RUNBOOK_DONE -> RESPONSE_READY:
  reason "Docs first"

gate UPDATE_READY UPDATE_DONE -> RESPONSE_READY:
  reason "Need news"

task VERIFY RESPONSE_READY -> CLOSED:
  title "Confirm"
  duration 1d
  requires:
    OPERATORS 1
