project CYCLE:
  title "循環"
  duration_unit day
  finish DONE

milestone NOW:
  title "現在"
  state reached

milestone A:
  title "A"

milestone B:
  title "B"

milestone DONE:
  title "完了"

task START NOW -> A:
  title "開始"
