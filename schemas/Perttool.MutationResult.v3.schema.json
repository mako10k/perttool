{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.MutationResult.v3.schema.json",
  "title": "Perttool.MutationResult.v3",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "changed",
    "original_digest",
    "updated_digest",
    "updated_text",
    "diff",
    "edits",
    "write",
    "governance",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.MutationResult.v3"
    },
    "cli_contract_version": {
      "const": 6
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "original_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "updated_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "updated_text": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "diff": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "edits": {
      "type": "array",
      "items": {
        "$ref": "Perttool.Common.v1.schema.json#/$defs/edit"
      }
    },
    "write": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/write"
    },
    "governance": {
      "oneOf": [
        {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/governanceDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "model_version",
            "task_id",
            "from_state",
            "to_state",
            "event",
            "coverage"
          ],
          "properties": {
            "model_version": {
              "const": 1
            },
            "task_id": {
              "type": "string"
            },
            "from_state": {
              "type": "string"
            },
            "to_state": {
              "type": "string"
            },
            "event": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/workEvent"
            },
            "coverage": {
              "enum": [
                "none",
                "finish_only",
                "complete"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "advance": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
