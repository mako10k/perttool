{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.CommandHelpResult.v1.schema.json",
  "title": "Perttool.CommandHelpResult.v1",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "query",
    "resources",
    "commands",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.CommandHelpResult.v1"
    },
    "cli_contract_version": {
      "const": 7
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "help"
    },
    "ok": {
      "type": "boolean"
    },
    "query": {
      "type": "object",
      "required": [
        "resource",
        "action"
      ],
      "properties": {
        "resource": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "action": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary",
          "actions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "actions": {
            "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
          }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cli_contract_version",
          "path",
          "operation",
          "summary",
          "operands",
          "options",
          "input",
          "output",
          "stdin",
          "effect",
          "result_schemas",
          "exit_statuses",
          "examples"
        ],
        "properties": {
          "cli_contract_version": {
            "const": 7
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2
          },
          "operation": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "operands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value_type",
                "required",
                "position"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value_type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind",
                "value_type",
                "required",
                "repeatable",
                "default",
                "enum_values",
                "conflicts",
                "requires",
                "shared_group",
                "description",
                "spelling"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "flag",
                    "value"
                  ]
                },
                "value_type": {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                },
                "required": {
                  "type": "boolean"
                },
                "repeatable": {
                  "type": "boolean"
                },
                "default": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "enum_values": {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                },
                "conflicts": {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                },
                "requires": {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                },
                "shared_group": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "diagnostics",
                    "governance",
                    "guide",
                    "preview",
                    "result",
                    "write",
                    null
                  ]
                },
                "description": {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                },
                "spelling": {
                  "type": "object",
                  "required": [
                    "cli",
                    "dsl",
                    "json"
                  ],
                  "properties": {
                    "cli": {
                      "type": "string"
                    },
                    "dsl": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                    },
                    "json": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "input": {
            "enum": [
              "none",
              "document",
              "artifact"
            ]
          },
          "output": {
            "type": "object",
            "required": [
              "formats",
              "payload",
              "file_effect"
            ],
            "properties": {
              "formats": {
                "type": "array",
                "items": {
                  "enum": [
                    "text",
                    "json"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "payload": {
                "enum": [
                  "result",
                  "candidate-document",
                  "artifact"
                ]
              },
              "file_effect": {
                "enum": [
                  "none",
                  "optional-create",
                  "optional-write-or-create"
                ]
              }
            },
            "additionalProperties": false
          },
          "stdin": {
            "type": "object",
            "required": [
              "document",
              "artifact",
              "request",
              "mutually_exclusive"
            ],
            "properties": {
              "document": {
                "type": "boolean"
              },
              "artifact": {
                "type": "boolean"
              },
              "request": {
                "type": "boolean"
              },
              "mutually_exclusive": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "effect": {
            "enum": [
              "read",
              "preview",
              "write-or-create"
            ]
          },
          "result_schemas": {
            "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
          },
          "exit_statuses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "meaning"
              ],
              "properties": {
                "code": {
                  "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5,
                    70
                  ]
                },
                "meaning": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "invocation",
                "summary"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "invocation": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    }
  },
  "additionalProperties": false
}
