{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.CliError.v1.schema.json",
  "title": "Perttool.CliError.v1",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.CliError.v1"
    },
    "cli_contract_version": {
      "const": 6
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "const": false
    },
    "help_target": {
      "type": "object",
      "required": [
        "resource",
        "action"
      ],
      "properties": {
        "resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "kind",
        "token",
        "suggestion"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "token": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "suggestion": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    }
  },
  "additionalProperties": false
}
