{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.CliError.v1.schema.json",
  "title": "Perttool.CliError.v1",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.CliError.v1"
    },
    "cli_contract_version": {
      "const": 7
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "const": false
    },
    "help_target": {
      "type": "object",
      "required": [
        "resource",
        "action"
      ],
      "properties": {
        "resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "kind",
        "token",
        "suggestion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing_resource",
            "unknown_resource",
            "missing_action",
            "unknown_action",
            "unknown_option",
            "missing_option_value",
            "unexpected_option_value",
            "duplicate_option",
            "invalid_option_value",
            "missing_operand",
            "extra_operand",
            "missing_required_option",
            "option_conflict",
            "option_requires"
          ]
        },
        "token": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "suggestion": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "resource",
                    "action",
                    "option"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    }
  },
  "additionalProperties": false
}
