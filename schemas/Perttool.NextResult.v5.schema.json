{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.NextResult.v5.schema.json",
  "title": "Perttool.NextResult.v5",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "recommendation_interface_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "grammar_version",
    "temporal"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.NextResult.v5"
    },
    "cli_contract_version": {
      "const": 6
    },
    "recommendation_interface_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "dag.next"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "grammar_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "duration_unit": {
      "enum": [
        "day",
        "hour",
        "point"
      ]
    },
    "velocity": {
      "type": [
        "object",
        "null"
      ]
    },
    "velocity_forecast": {
      "type": [
        "object",
        "null"
      ]
    },
    "capacity_overrides": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/capacityOverrides"
    },
    "recommendation": {
      "type": "object"
    },
    "groups": {
      "type": "object",
      "required": [
        "active",
        "ready",
        "runnable_now",
        "blocked_now",
        "upcoming",
        "suspended"
      ],
      "properties": {
        "active": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "ready": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "runnable_now": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "blocked_now": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "upcoming": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "suspended": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "temporal": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
