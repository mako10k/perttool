{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.FormatResult.v1.schema.json",
  "title": "Perttool.FormatResult.v1",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "changed",
    "original_digest",
    "updated_digest",
    "updated_text",
    "diff",
    "edits",
    "write"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.FormatResult.v1"
    },
    "cli_contract_version": {
      "const": 7
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "document.format"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "original_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "updated_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "updated_text": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "diff": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "edits": {
      "type": "array",
      "items": {
        "$ref": "Perttool.Common.v1.schema.json#/$defs/edit"
      }
    },
    "write": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/write"
    }
  },
  "additionalProperties": false
}
