{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.ProjectHistoryResult.v1.schema.json",
  "title": "Perttool.ProjectHistoryResult.v1",
  "$defs": {
    "eventHistory": {
      "type": "object",
      "required": [
        "event",
        "evidence_class",
        "first_seen_commit_id",
        "last_seen_commit_id",
        "removal_commit_id",
        "payload_digest"
      ],
      "properties": {
        "event": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/workEvent"
        },
        "evidence_class": {
          "const": "declared_actual"
        },
        "first_seen_commit_id": {
          "type": "string"
        },
        "last_seen_commit_id": {
          "type": "string"
        },
        "removal_commit_id": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "payload_digest": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "gitRecordedTransition": {
      "type": "object",
      "required": [
        "task_id",
        "from_state",
        "to_state",
        "commit_id",
        "recorded_at",
        "source_digest",
        "evidence_class"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "from_state": {
          "$ref": "#/$defs/recordedTaskState"
        },
        "to_state": {
          "$ref": "#/$defs/recordedTaskState"
        },
        "commit_id": {
          "type": "string"
        },
        "recorded_at": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableCalendarValue"
        },
        "source_digest": {
          "type": "string"
        },
        "evidence_class": {
          "const": "git_recorded_transition"
        }
      },
      "additionalProperties": false
    },
    "recordedTaskState": {
      "enum": [
        "absent",
        "planned",
        "active",
        "blocked",
        "suspended",
        "done"
      ]
    },
    "suspensionInterval": {
      "type": "object",
      "required": [
        "suspend_event_id",
        "resume_event_id",
        "start",
        "finish",
        "duration"
      ],
      "properties": {
        "suspend_event_id": {
          "type": "string"
        },
        "resume_event_id": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "start": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
        },
        "finish": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableCalendarValue"
        },
        "duration": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "coverage",
        "event_ids",
        "first_start",
        "last_finish",
        "suspension_intervals",
        "cycle_time",
        "derived_active_time",
        "explicit_active_time",
        "effort",
        "planned_value",
        "baseline_source",
        "baseline_event_id",
        "baseline_commit_id",
        "qualifiers",
        "unavailable_causes"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "coverage": {
          "enum": [
            "open",
            "finish_only",
            "complete",
            "unrecorded",
            "unavailable"
          ]
        },
        "event_ids": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "first_start": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableCalendarValue"
        },
        "last_finish": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableCalendarValue"
        },
        "suspension_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suspensionInterval"
          }
        },
        "cycle_time": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        },
        "derived_active_time": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        },
        "explicit_active_time": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        },
        "effort": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        },
        "planned_value": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableQuantity"
        },
        "baseline_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "start_baseline",
            "finish_snapshot",
            null
          ]
        },
        "baseline_event_id": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "baseline_commit_id": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
        },
        "qualifiers": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "unavailable_causes": {
          "type": "array",
          "items": {
            "$ref": "Perttool.Common.v1.schema.json#/$defs/actualsCause"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "grammar_version",
    "history",
    "events",
    "git_recorded_transitions",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.ProjectHistoryResult.v1"
    },
    "cli_contract_version": {
      "const": 6
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "project.history"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "grammar_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "history": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/historyMetadata"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventHistory"
      }
    },
    "git_recorded_transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gitRecordedTransition"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "additionalProperties": false
}
