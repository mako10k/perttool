          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "zone_id",
            "tzdb_release",
            "calendar_id",
            "workday_hours"
          ],
          "properties": {
            "kind": {
              "const": "named_zone"
            },
            "zone_id": {
              "type": "string"
            },
            "tzdb_release": {
              "type": "string"
            },
            "calendar_id": {
              "type": "string"
            },
            "workday_hours": {
              "oneOf": [
                {
                  "$ref": "#/$defs/basisRational"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "basisCalendar": {
      "type": "object",
      "required": [
        "id",
        "profile",
        "weekdays",
        "exceptions"
      ],
      "properties": {
        "id": {
          "type": "string"
