        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone_link_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_link_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
