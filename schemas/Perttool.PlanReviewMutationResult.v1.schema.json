        },
        "candidate_digest": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
        },
        "actor": {
          "type": "string"
        },
        "effective_dag_owner": {
          "type": "string"
        },
        "effective_dag_delegates": {
          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
        },
        "actor_direct": {
          "type": "boolean"
        },
        "owner_confirmation_required": {
          "type": "boolean"
        },
        "owner_confirmation_satisfied": {
          "type": "boolean"
        },
        "authorized": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "title": "Perttool.PlanReviewAuthorityDecision.v1"
    },
    "createRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "request_id",
        "task_id",
        "reason",
        "created_at",
        "actor"
      ],
      "properties": {
        "schema_version": {
          "const": "Perttool.PlanReviewCreateRequest.v1"
        },
        "request_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "title": "Perttool.PlanReviewCreateRequest.v1"
    },
    "resolveRequest": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "request_id",
            "outcome",
            "resolved_at",
            "actor",
            "resolution_reason"
          ],
          "properties": {
            "schema_version": {
              "const": "Perttool.PlanReviewResolveRequest.v1"
            },
            "request_id": {
              "type": "string"
            },
            "resolved_at": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "resolution_reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_owners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "const": "plan_retained"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "request_id",
            "outcome",
            "resolved_at",
            "actor",
            "resolution_reason",
            "request"
          ],
          "properties": {
            "schema_version": {
              "const": "Perttool.PlanReviewResolveRequest.v1"
            },
            "request_id": {
              "type": "string"
            },
            "resolved_at": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "resolution_reason": {
              "type": "string",
              "minLength": 1
            },
            "accepted_owners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outcome": {
              "const": "plan_changed"
            },
            "request": {
              "$ref": "#/$defs/batchRequest"
            }
          },
          "additionalProperties": false
        }
      ],
      "title": "Perttool.PlanReviewResolveRequest.v1"
    },
    "basisRational": {
      "type": "object",
      "required": [
        "numerator",
        "denominator"
