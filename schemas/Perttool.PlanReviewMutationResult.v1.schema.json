      "properties": {
        "kind": {
          "const": "date"
        },
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "basisDateTime": {
      "type": "object",
      "required": [
        "kind",
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second",
        "offset_minutes"
