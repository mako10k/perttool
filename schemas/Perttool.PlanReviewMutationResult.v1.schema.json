        "hour": {
          "type": "integer"
        },
        "minute": {
          "type": "integer"
        },
        "second": {
          "$ref": "#/$defs/basisRational"
        },
        "offset_minutes": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "basisCalendarValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/basisDate"
        },
        {
          "$ref": "#/$defs/basisDateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "basisTiming": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "duration"
            },
            "value": {
              "$ref": "#/$defs/basisExact"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "optimistic",
            "most_likely",
            "pessimistic"
          ],
          "properties": {
            "kind": {
              "const": "estimate"
            },
            "optimistic": {
              "$ref": "#/$defs/basisExact"
            },
            "most_likely": {
              "$ref": "#/$defs/basisExact"
            },
            "pessimistic": {
              "$ref": "#/$defs/basisExact"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "basisCalendarProfile": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
