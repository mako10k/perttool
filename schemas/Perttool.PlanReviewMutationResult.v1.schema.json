              },
              "windows": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/basisWindow"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "windows"
            ],
            "properties": {
              "date": {
                "type": "string"
              },
              "windows": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/basisWindow"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "basisResource": {
      "type": "object",
      "required": [
        "id",
        "capacity",
        "calendar_id",
        "available_from",
        "available_until",
        "overrides"
