        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "timing": {
          "$ref": "#/$defs/basisTiming"
        },
        "priority": {
          "type": "integer"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisRequirement"
          }
        },
        "owner": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "calendar_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisConstraint"
          }
        },
        "deadline": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "basisPlanningPool": {
      "type": "object",
      "required": [
        "works",
        "events",
        "activities",
        "windows",
        "work_order"
      ],
      "properties": {
        "works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisWork"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisEvent"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisActivity"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "objective",
              "start",
              "end",
              "work_ids"
