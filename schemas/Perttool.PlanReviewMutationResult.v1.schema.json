    "basisEvent": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "tags",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "basisActivity": {
      "type": "object",
      "required": [
        "id",
        "from_id",
        "to_id",
        "title",
        "description",
        "timing",
        "priority",
        "requirements",
        "owner",
        "tags",
        "source",
        "calendar_id",
        "when",
        "deadline"
