            "id",
            "finish_milestone_id",
            "duration_unit",
            "velocity",
            "target_duration",
            "critical_epsilon"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "finish_milestone_id": {
              "type": "string"
            },
            "duration_unit": {
              "enum": [
                "day",
                "hour",
                "point"
              ]
            },
            "velocity": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_duration": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
