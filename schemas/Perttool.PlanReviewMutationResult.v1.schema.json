      "properties": {
        "relation_id": {
          "type": "string"
        },
        "predecessor_task_id": {
          "type": "string"
        },
        "successor_task_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "explicit": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "basisWork": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "event_ids",
        "activity_ids",
        "milestone_link_ids",
        "task_link_ids",
        "depends_on_ids"
