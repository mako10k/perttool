        "deadline": {
          "$ref": "#/$defs/basisCalendarValue"
        },
        "priority": {
          "type": "integer"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisRequirement"
          }
        },
        "owner": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "temporal_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisConstraint"
          }
        }
      },
      "additionalProperties": false
