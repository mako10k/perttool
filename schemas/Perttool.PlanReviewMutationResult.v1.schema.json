        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "capacity"
            ],
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "capacity": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "basisMilestone": {
      "type": "object",
      "required": [
        "id",
        "deadline",
        "temporal_constraints"
