      "properties": {
        "id": {
          "type": "string"
        },
        "deadline": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "temporal_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisConstraint"
          }
        }
      },
      "additionalProperties": false
    },
    "basisTask": {
      "type": "object",
      "required": [
        "id",
        "from_milestone_id",
        "to_milestone_id",
        "description",
        "timing",
        "not_before",
        "deadline",
        "priority",
        "requirements",
        "owner",
        "tags",
        "source",
        "temporal_constraints"
