        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisGate"
          }
        },
        "assurance_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basisRelation"
          }
        },
        "planning_pool": {
