{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.Common.v1.schema.json",
  "title": "perttool shared JSON definitions",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "position": {
      "type": "object",
      "required": [
        "offset",
        "line",
        "column"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string"
        },
        "entity_id": {
          "$ref": "#/$defs/nullableString"
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedLocation"
          }
        },
        "help_topic": {
          "$ref": "#/$defs/nullableString"
        },
        "guide_topic": {
          "$ref": "#/$defs/nullableString"
        },
        "expected_syntax": {
          "$ref": "#/$defs/nullableString"
        },
        "fixes": {
          "type": "array",
          "maxItems": 0
        },
        "data": {
          "$ref": "#/$defs/jsonObject"
        },
        "provider_id": {
          "$ref": "#/$defs/nullableString"
        },
        "surface_id": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "relatedLocation": {
      "type": "object",
      "required": [
        "message",
        "span"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "edit": {
      "type": "object",
      "required": [
        "start_offset",
        "end_offset",
        "replacement"
      ],
      "properties": {
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0
        },
        "replacement": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "write": {
      "type": "object",
      "required": [
        "mode",
        "target",
        "written"
      ],
      "properties": {
        "mode": {
          "enum": [
            "preview",
            "in_place",
            "out"
          ]
        },
        "target": {
          "$ref": "#/$defs/nullableString"
        },
        "written": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rational": {
      "type": "object",
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "unit"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "unit": {
          "enum": [
            "day",
            "hour",
            "point",
            "person_hour"
          ]
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "displayedRational": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "unit",
        "display"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "unit": {
          "enum": [
            "day",
            "hour",
            "point",
            "day^2",
            "hour^2",
            "point^2",
            "ratio"
          ]
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nullableDisplayedRational": {
      "oneOf": [
        {
          "$ref": "#/$defs/displayedRational"
        },
        {
          "type": "null"
        }
      ]
    },
    "velocity": {
      "type": "object",
      "required": [
        "points",
        "period"
      ],
      "properties": {
        "points": {
          "$ref": "#/$defs/displayedRational"
        },
        "period": {
          "$ref": "#/$defs/displayedRational"
        }
      },
      "additionalProperties": false
    },
    "nullableVelocity": {
      "oneOf": [
        {
          "$ref": "#/$defs/velocity"
        },
        {
          "type": "null"
        }
      ]
    },
    "velocityForecast": {
      "type": "object",
      "required": [
        "qualifier",
        "source_unit",
        "target_unit",
        "precedence_makespan",
        "resource_makespan"
      ],
      "properties": {
        "qualifier": {
          "const": "velocity_forecast"
        },
        "source_unit": {
          "enum": [
            "day",
            "hour",
            "point"
          ]
        },
        "target_unit": {
          "enum": [
            "day",
            "hour",
            "point"
          ]
        },
        "precedence_makespan": {
          "$ref": "#/$defs/nullableDisplayedRational"
        },
        "resource_makespan": {
          "$ref": "#/$defs/nullableDisplayedRational"
        }
      },
      "additionalProperties": false
    },
    "nullableVelocityForecast": {
      "oneOf": [
        {
          "$ref": "#/$defs/velocityForecast"
        },
        {
          "type": "null"
        }
      ]
    },
    "calendarValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source_text",
            "year",
            "month",
            "day"
          ],
          "properties": {
            "kind": {
              "const": "date"
            },
            "source_text": {
              "type": "string"
            },
            "year": {
              "type": "integer"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_text",
            "year",
            "month",
            "day",
            "hour",
            "minute",
            "second",
            "offset_minutes"
          ],
          "properties": {
            "kind": {
              "const": "date_time"
            },
            "source_text": {
              "type": "string"
            },
            "year": {
              "type": "integer"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "second": {
              "$ref": "#/$defs/rational"
            },
            "offset_minutes": {
              "type": "integer",
              "minimum": -1439,
              "maximum": 1439
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "workEvent": {
      "type": "object",
      "required": [
        "model_version",
        "id",
        "task_id",
        "kind",
        "occurred_at",
        "planned_value",
        "active_time",
        "effort",
        "reason"
      ],
      "properties": {
        "model_version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "start",
            "suspend",
            "resume",
            "finish"
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/calendarValue"
        },
        "planned_value": {
          "oneOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_time": {
          "oneOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "oneOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "nullableCalendarValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/calendarValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableQuantity": {
      "oneOf": [
        {
          "$ref": "#/$defs/quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporalExact": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "unit"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "unit": {
          "enum": [
            "day",
            "hour",
            "point"
          ]
        }
      },
      "additionalProperties": false
    },
    "nullableTemporalExact": {
      "oneOf": [
        {
          "$ref": "#/$defs/temporalExact"
        },
        {
          "type": "null"
        }
      ]
    },
    "calendarDifference": {
      "type": "object",
      "required": [
        "kind",
        "exact"
      ],
      "properties": {
        "kind": {
          "enum": [
            "calendar_days",
            "si_seconds"
          ]
        },
        "exact": {
          "$ref": "#/$defs/rational"
        }
      },
      "additionalProperties": false
    },
    "nullableCalendarDifference": {
      "oneOf": [
        {
          "$ref": "#/$defs/calendarDifference"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporalCause": {
      "type": "object",
      "required": [
        "cause",
        "underlying_cause",
        "subject_kind",
        "subject_id",
        "task_id"
      ],
      "properties": {
        "cause": {
          "enum": [
            "missing_temporal_anchor",
            "incomparable_temporal_kinds",
            "date_anchor_has_no_clock",
            "fractional_date_projection",
            "calendar_range_overflow",
            "exact_datetime_text_unavailable",
            "complete_actual_time_unavailable",
            "release_bound_unavailable",
            "precedence_projection_unavailable",
            "resource_projection_unavailable",
            "margin_unit_unavailable"
          ]
        },
        "underlying_cause": {
          "$ref": "#/$defs/nullableString"
        },
        "subject_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "project",
            "milestone",
            "task",
            null
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/nullableString"
        },
        "task_id": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "temporalCauses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporalCause"
      }
    },
    "temporalPoint": {
      "type": "object",
      "required": [
        "state",
        "relative",
        "calendar",
        "unavailable_causes"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_applicable",
            "unavailable",
            "available"
          ]
        },
        "relative": {
          "$ref": "#/$defs/nullableTemporalExact"
        },
        "calendar": {
          "$ref": "#/$defs/nullableCalendarValue"
        },
        "unavailable_causes": {
          "$ref": "#/$defs/temporalCauses"
        }
      },
      "additionalProperties": false
    },
    "nullableTemporalPoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/temporalPoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporalSchedule": {
      "type": "object",
      "required": [
        "state",
        "view",
        "algorithm",
        "conditional_on_blocks_resolved",
        "blocked_task_ids",
        "unavailable_causes",
        "tasks",
        "milestones",
        "conditional_on_suspensions_resumed",
        "suspended_task_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "unavailable",
            "available"
          ]
        },
        "view": {
          "enum": [
            "precedence",
            "resource"
          ]
        },
        "algorithm": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "id",
                "version",
                "optimal",
                "scheduler_id",
                "scheduler_version"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "optimal": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "scheduler_id": {
                  "$ref": "#/$defs/nullableString"
                },
                "scheduler_version": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "conditional_on_blocks_resolved": {
          "type": "boolean"
        },
        "blocked_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "unavailable_causes": {
          "$ref": "#/$defs/temporalCauses"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "declared_not_before",
              "release_state",
              "release_bound",
              "start",
              "finish",
              "unavailable_causes"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "declared_not_before": {
                "$ref": "#/$defs/nullableCalendarValue"
              },
              "release_state": {
                "enum": [
                  "not_applicable",
                  "unavailable",
                  "available"
                ]
              },
              "release_bound": {
                "$ref": "#/$defs/nullableTemporalExact"
              },
              "start": {
                "$ref": "#/$defs/temporalPoint"
              },
              "finish": {
                "$ref": "#/$defs/temporalPoint"
              },
              "unavailable_causes": {
                "$ref": "#/$defs/temporalCauses"
              }
            },
            "additionalProperties": false
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "milestone_id",
              "reach",
              "unavailable_causes"
            ],
            "properties": {
              "milestone_id": {
                "type": "string"
              },
              "reach": {
                "$ref": "#/$defs/temporalPoint"
              },
              "unavailable_causes": {
                "$ref": "#/$defs/temporalCauses"
              }
            },
            "additionalProperties": false
          }
        },
        "conditional_on_suspensions_resumed": {
          "type": "boolean"
        },
        "suspended_task_ids": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "deadlineView": {
      "type": "object",
      "required": [
        "state",
        "projected_completion",
        "forecast_relation",
        "signed_margin",
        "base_unit_margin",
        "remaining_margin",
        "lateness",
        "assessment",
        "optimal",
        "conditional_on_blocks_resolved",
        "blocked_task_ids",
        "unavailable_causes"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_applicable",
            "unavailable",
            "available"
          ]
        },
        "projected_completion": {
          "$ref": "#/$defs/nullableCalendarValue"
        },
        "forecast_relation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "before_deadline",
            "on_deadline",
            "after_deadline",
            null
          ]
        },
        "signed_margin": {
          "$ref": "#/$defs/nullableCalendarDifference"
        },
        "base_unit_margin": {
          "$ref": "#/$defs/nullableTemporalExact"
        },
        "remaining_margin": {
          "$ref": "#/$defs/nullableTemporalExact"
        },
        "lateness": {
          "$ref": "#/$defs/nullableTemporalExact"
        },
        "assessment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lower_bound_on_time",
            "lower_bound_late",
            "heuristic_on_time",
            "heuristic_late",
            null
          ]
        },
        "optimal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "conditional_on_blocks_resolved": {
          "type": "boolean"
        },
        "blocked_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "unavailable_causes": {
          "$ref": "#/$defs/temporalCauses"
        }
      },
      "additionalProperties": false
    },
    "deadlineEvaluation": {
      "type": "object",
      "required": [
        "subject",
        "deadline",
        "completion_state",
        "current",
        "precedence",
        "resource",
        "combined_assessment",
        "conditional_on_blocks_resolved",
        "blocked_task_ids",
        "destination_relationship",
        "conditional_on_suspensions_resumed",
        "suspended_task_ids"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "roles"
          ],
          "properties": {
            "kind": {
              "enum": [
                "task",
                "milestone"
              ]
            },
            "id": {
              "type": "string"
            },
            "roles": {
              "type": "array",
              "items": {
                "enum": [
                  "task",
                  "milestone",
                  "project_finish"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "deadline": {
          "$ref": "#/$defs/calendarValue"
        },
        "completion_state": {
          "enum": [
            "incomplete",
            "complete_actual_time_unavailable"
          ]
        },
        "current": {
          "type": "object",
          "required": [
            "state",
            "signed_window",
            "base_unit_window",
            "unavailable_causes"
          ],
          "properties": {
            "state": {
              "enum": [
                "not_due",
                "due_now",
                "overdue",
                "not_applicable",
                "unavailable"
              ]
            },
            "signed_window": {
              "$ref": "#/$defs/nullableCalendarDifference"
            },
            "base_unit_window": {
              "$ref": "#/$defs/nullableTemporalExact"
            },
            "unavailable_causes": {
              "$ref": "#/$defs/temporalCauses"
            }
          },
          "additionalProperties": false
        },
        "precedence": {
          "$ref": "#/$defs/deadlineView"
        },
        "resource": {
          "$ref": "#/$defs/deadlineView"
        },
        "combined_assessment": {
          "enum": [
            "overdue",
            "forecast_infeasible",
            "at_risk",
            "forecast_on_time",
            "not_proven_late",
            "not_applicable",
            "unavailable"
          ]
        },
        "conditional_on_blocks_resolved": {
          "type": "boolean"
        },
        "blocked_task_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "destination_relationship": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "milestone_id",
                "relation"
              ],
              "properties": {
                "milestone_id": {
                  "type": "string"
                },
                "relation": {
                  "enum": [
                    "task_deadline_before_milestone",
                    "same_deadline",
                    "task_deadline_after_milestone",
                    "unavailable",
                    "deadline_absent"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "conditional_on_suspensions_resumed": {
          "type": "boolean"
        },
        "suspended_task_ids": {
