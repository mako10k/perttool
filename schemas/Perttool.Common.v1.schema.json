            "shallow_boundary",
            "unsupported_rename",
            "unsupported_source_version",
            "task_identity_replaced",
            "event_payload_changed",
            "duplicate_event_identity",
            "head_changed",
            "target_changed"
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/nullableString"
        },
        "task_id": {
          "$ref": "#/$defs/nullableString"
        },
