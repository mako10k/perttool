            },
            "unit": {
              "$ref": "#/$defs/nullableRecommendationUnit"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "recommendationExpression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "left",
            "relation",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "compare"
            },
            "left": {
              "$ref": "#/$defs/recommendationExpressionTerm"
            },
            "relation": {
              "enum": [
                "equal",
                "not_equal",
                "less_than",
                "less_or_equal",
                "greater_than",
                "greater_or_equal",
                "contains"
              ]
            },
            "right": {
              "$ref": "#/$defs/recommendationExpressionTerm"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "children"
          ],
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/recommendationExpression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
