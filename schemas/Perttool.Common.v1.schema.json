    "recommendationExpressionTerm": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "fact_id"
          ],
          "properties": {
            "kind": {
              "const": "fact"
            },
            "fact_id": {
              "type": "string"
