          "type": "boolean"
        },
        "owner_confirmation_required": {
          "type": "boolean"
        },
        "owner_confirmation_present": {
          "type": "boolean"
        },
        "scope_authorized": {
          "type": "boolean"
        },
        "denial_cause": {
          "type": [
            "string",
