      "properties": {
        "kind": {
          "enum": [
            "project",
            "task",
            "milestone",
            "gate",
            "resource",
            "policy_rule",
            "ranking_factor",
            "negative_fact_kind",
            "derived_set"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recommendationScalarValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "numerator",
            "denominator"
          ],
          "properties": {
            "type": {
              "const": "rational"
            },
            "numerator": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "enum_type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "enum"
            },
            "enum_type": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "entity"
            },
            "value": {
              "$ref": "#/$defs/recommendationEntity"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "recommendationValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/recommendationScalarValue"
        },
        {
          "type": "object",
          "required": [
            "type",
            "item_type",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "list",
                "set"
              ]
            },
            "item_type": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/recommendationScalarValue"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "key_type",
            "value_type",
            "entries"
          ],
          "properties": {
            "type": {
              "const": "map"
            },
            "key_type": {
              "type": "string"
            },
            "value_type": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "properties": {
                  "key": {
                    "$ref": "#/$defs/recommendationScalarValue"
                  },
                  "value": {
                    "$ref": "#/$defs/recommendationScalarValue"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
