            "missing_baseline",
            "active_time_absent",
            "effort_absent",
            "history_incomplete",
            "history_unavailable"
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/nullableString"
        },
        "task_id": {
          "$ref": "#/$defs/nullableString"
        },
