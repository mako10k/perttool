{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.ProjectResult.v5.schema.json",
  "title": "Perttool.ProjectResult.v5",
  "$defs": {
    "instant": {
      "type": "object", "required": ["source_text", "instant_seconds", "offset_minutes", "span"],
      "properties": {
        "source_text": { "type": "string" }, "instant_seconds": { "$ref": "Perttool.Common.v1.schema.json#/$defs/rational" },
        "offset_minutes": { "type": "integer", "minimum": -840, "maximum": 840 }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
      }, "additionalProperties": false
    },
    "window": {
      "type": "object", "required": ["start_minute", "end_minute", "span"],
      "properties": { "start_minute": { "type": "integer", "minimum": 0, "maximum": 1439 }, "end_minute": { "type": "integer", "minimum": 1, "maximum": 1440 }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" } },
      "additionalProperties": false
    },
    "calendar": {
      "type": "object", "required": ["id", "span", "id_span", "weekdays", "exceptions"],
      "properties": {
        "id": { "type": "string" }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }, "id_span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" },
        "weekdays": { "type": "array", "items": { "type": "object", "required": ["weekday", "windows", "span"], "properties": {
          "weekday": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }, "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
        }, "additionalProperties": false } },
        "exceptions": { "type": "array", "items": { "type": "object", "required": ["date", "windows", "span"], "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "windows": { "type": "array", "items": { "$ref": "#/$defs/window" } }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
        }, "additionalProperties": false } }
      }, "additionalProperties": false
    },
    "resourceAvailability": {
      "type": "object", "required": ["resource_id", "calendar_id", "available_from", "available_until", "overrides", "span"],
      "properties": {
        "resource_id": { "type": "string" }, "calendar_id": { "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString" },
        "available_from": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] }, "available_until": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] },
        "overrides": { "type": "array", "items": { "type": "object", "required": ["start", "end", "capacity", "span"], "properties": {
          "start": { "$ref": "#/$defs/instant" }, "end": { "$ref": "#/$defs/instant" }, "capacity": { "type": "number", "exclusiveMinimum": 0 }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
        }, "additionalProperties": false } }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
      }, "additionalProperties": false
    },
    "eventBound": {
      "type": "object", "required": ["entity_kind", "entity_id", "event", "direction", "value", "span"],
      "properties": {
        "entity_kind": { "enum": ["task", "milestone"] }, "entity_id": { "type": "string" }, "event": { "enum": ["start", "finish", "reach"] },
        "direction": { "enum": ["earliest", "latest"] }, "value": { "$ref": "#/$defs/instant" }, "span": { "$ref": "Perttool.Common.v1.schema.json#/$defs/span" }
      }, "additionalProperties": false
    },
    "temporalSchedule": {
      "type": "object", "required": ["model_version", "grammar_version", "document_id", "as_of", "profile", "calendars", "resources", "task_bounds", "milestone_bounds"],
      "properties": {
        "model_version": { "const": 1 }, "grammar_version": { "const": 8 }, "document_id": { "type": "string" },
        "as_of": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] },
        "profile": { "oneOf": [
          { "type": "object", "required": ["kind", "zone_id", "tzdb_release", "calendar_id", "workday_hours"], "properties": {
            "kind": { "const": "named_zone" }, "zone_id": { "type": "string" }, "tzdb_release": { "const": "2026c" }, "calendar_id": { "type": "string" },
            "workday_hours": { "oneOf": [{ "$ref": "Perttool.Common.v1.schema.json#/$defs/rational" }, { "type": "null" }] }
          }, "additionalProperties": false },
          { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "continuous_fixed_offset" } }, "additionalProperties": false }
        ] },
        "calendars": { "type": "array", "items": { "$ref": "#/$defs/calendar" } }, "resources": { "type": "array", "items": { "$ref": "#/$defs/resourceAvailability" } },
        "task_bounds": { "type": "array", "items": { "$ref": "#/$defs/eventBound" } }, "milestone_bounds": { "type": "array", "items": { "$ref": "#/$defs/eventBound" } }
      }, "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "grammar_version",
    "project",
    "temporal_schedule"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.ProjectResult.v5"
    },
    "cli_contract_version": {
      "const": 9
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "project.show"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "grammar_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 8
    },
    "temporal_schedule": {
      "oneOf": [{ "$ref": "#/$defs/temporalSchedule" }, { "type": "null" }]
    },
    "project": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "title",
            "description",
            "as_of",
            "duration_unit",
            "velocity",
            "finish",
            "finish_deadline",
            "governance",
            "critical_epsilon",
            "target_duration",
            "plan_assurance_model",
            "plan_assurance_hash_model"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "title": {
              "type": "string"
            },
            "description": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "as_of": {
              "oneOf": [
                {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_unit": {
              "enum": [
                "day",
                "hour",
                "point"
              ]
            },
            "velocity": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "finish": {
              "type": "string"
            },
            "finish_deadline": {
              "oneOf": [
                {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "governance": {
              "type": "object",
              "required": [
                "source_contract_version",
                "declared",
                "effective"
              ],
              "properties": {
                "source_contract_version": {
                  "const": 1
                },
                "declared": {
                  "type": "object",
                  "required": [
                    "goal_owner",
                    "goal_delegates",
                    "dag_owner",
                    "dag_delegates"
                  ],
                  "properties": {
                    "goal_owner": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                    },
                    "goal_delegates": {
                      "oneOf": [
                        {
                          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dag_owner": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                    },
                    "dag_delegates": {
                      "oneOf": [
                        {
                          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "effective": {
                  "type": "object",
                  "required": [
                    "goal_owner",
                    "goal_delegates",
                    "dag_owner",
                    "dag_delegates"
                  ],
                  "properties": {
                    "goal_owner": {
                      "type": "string"
                    },
                    "goal_delegates": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                    },
                    "dag_owner": {
                      "type": "string"
                    },
                    "dag_delegates": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "critical_epsilon": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "target_duration": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "plan_assurance_model": {
              "type": ["integer", "null"]
            },
            "plan_assurance_hash_model": {
              "type": ["integer", "null"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
