{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.ProjectResult.v5.schema.json",
  "title": "Perttool.ProjectResult.v5",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "grammar_version",
    "project",
    "temporal_schedule"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.ProjectResult.v5"
    },
    "cli_contract_version": {
      "const": 9
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "project.show"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "grammar_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 8
    },
    "temporal_schedule": {
      "type": ["object", "null"]
    },
    "project": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "title",
            "description",
            "as_of",
            "duration_unit",
            "velocity",
            "finish",
            "finish_deadline",
            "governance",
            "critical_epsilon",
            "target_duration",
            "plan_assurance_model",
            "plan_assurance_hash_model"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "title": {
              "type": "string"
            },
            "description": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "as_of": {
              "oneOf": [
                {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_unit": {
              "enum": [
                "day",
                "hour",
                "point"
              ]
            },
            "velocity": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "finish": {
              "type": "string"
            },
            "finish_deadline": {
              "oneOf": [
                {
                  "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "governance": {
              "type": "object",
              "required": [
                "source_contract_version",
                "declared",
                "effective"
              ],
              "properties": {
                "source_contract_version": {
                  "const": 1
                },
                "declared": {
                  "type": "object",
                  "required": [
                    "goal_owner",
                    "goal_delegates",
                    "dag_owner",
                    "dag_delegates"
                  ],
                  "properties": {
                    "goal_owner": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                    },
                    "goal_delegates": {
                      "oneOf": [
                        {
                          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dag_owner": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
                    },
                    "dag_delegates": {
                      "oneOf": [
                        {
                          "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "effective": {
                  "type": "object",
                  "required": [
                    "goal_owner",
                    "goal_delegates",
                    "dag_owner",
                    "dag_delegates"
                  ],
                  "properties": {
                    "goal_owner": {
                      "type": "string"
                    },
                    "goal_delegates": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                    },
                    "dag_owner": {
                      "type": "string"
                    },
                    "dag_delegates": {
                      "$ref": "Perttool.Common.v1.schema.json#/$defs/stringArray"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "critical_epsilon": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "target_duration": {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
            },
            "plan_assurance_model": {
              "type": ["integer", "null"]
            },
            "plan_assurance_hash_model": {
              "type": ["integer", "null"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
