{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.CheckResult.v3.schema.json",
  "title": "Perttool.CheckResult.v3",
  "type": "object",
  "required": [
    "schema_version",
    "cli_contract_version",
    "tool_version",
    "operation",
    "ok",
    "document_id",
    "source",
    "source_digest",
    "diagnostics",
    "diagnostics_truncated",
    "grammar_version",
    "summary",
    "temporal_inputs",
    "actuals_inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "Perttool.CheckResult.v3"
    },
    "cli_contract_version": {
      "const": 6
    },
    "tool_version": {
      "type": "string"
    },
    "operation": {
      "const": "document.check"
    },
    "ok": {
      "type": "boolean"
    },
    "document_id": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableString"
    },
    "source": {
      "type": "string"
    },
    "source_digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "diagnostics": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/diagnostics"
    },
    "diagnostics_truncated": {
      "type": "boolean"
    },
    "grammar_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "summary": {
      "type": "object",
      "required": [
        "resources",
        "milestones",
        "tasks",
        "gates",
        "errors",
        "warnings"
      ],
      "properties": {
        "resources": {
          "type": "integer",
          "minimum": 0
        },
        "milestones": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "gates": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "temporal_inputs": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "anchor",
        "milestone_deadlines",
        "task_constraints"
      ],
      "properties": {
        "anchor": {
          "oneOf": [
            {
              "$ref": "Perttool.Common.v1.schema.json#/$defs/calendarValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "milestone_deadlines": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "task_constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "actuals_inputs": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model_version",
        "events"
      ],
      "properties": {
        "model_version": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "Perttool.Common.v1.schema.json#/$defs/workEvent"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
