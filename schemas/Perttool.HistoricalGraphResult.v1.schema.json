{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mako10k/perttool/schemas/Perttool.HistoricalGraphResult.v1.schema.json",
  "title": "Perttool.HistoricalGraphResult.v1",
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "digest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/digest"
    },
    "nullableDigest": {
      "$ref": "Perttool.Common.v1.schema.json#/$defs/nullableDigest"
    },
    "exactValue": {
      "type": "object",
      "required": ["numerator", "denominator", "unit"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "unit": { "enum": ["day", "hour", "point", "person_hour"] }
      },
      "additionalProperties": false
    },
    "analysisExactValue": {
      "type": "object",
      "required": ["numerator", "denominator", "unit"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "unit": { "enum": ["day", "hour", "point"] }
      },
      "additionalProperties": false
    },
    "calendarDate": {
      "type": "object",
      "required": ["kind", "year", "month", "day"],
      "properties": {
        "kind": { "const": "date" },
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      },
      "additionalProperties": false
    },
    "calendarDateTime": {
      "type": "object",
      "required": ["kind", "year", "month", "day", "hour", "minute", "second", "offset_minutes"],
      "properties": {
        "kind": { "const": "date_time" },
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
        "second": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
            "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
          },
          "additionalProperties": false
        },
        "offset_minutes": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "calendarValue": {
      "oneOf": [
        { "$ref": "#/$defs/calendarDate" },
        { "$ref": "#/$defs/calendarDateTime" }
      ]
    },
    "nullableCalendarValue": {
      "oneOf": [
        { "$ref": "#/$defs/calendarValue" },
        { "type": "null" }
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "duration" },
            "value": { "$ref": "#/$defs/exactValue" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "optimistic", "most_likely", "pessimistic"],
          "properties": {
            "kind": { "const": "estimate" },
            "optimistic": { "$ref": "#/$defs/exactValue" },
            "most_likely": { "$ref": "#/$defs/exactValue" },
            "pessimistic": { "$ref": "#/$defs/exactValue" }
          },
          "additionalProperties": false
        }
      ]
    },
    "milestoneSemantic": {
      "type": "object",
      "required": ["id", "title", "description", "state", "deadline", "tags"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "state": { "enum": ["planned", "reached"] },
        "deadline": { "$ref": "#/$defs/nullableCalendarValue" },
        "tags": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "taskSemantic": {
      "type": "object",
      "required": ["id", "from_milestone_id", "to_milestone_id", "plan", "lifecycle"],
      "properties": {
        "id": { "type": "string" },
        "from_milestone_id": { "type": "string" },
        "to_milestone_id": { "type": "string" },
        "plan": {
          "type": "object",
          "required": ["title", "description", "timing", "not_before", "deadline", "priority", "requirements", "owner", "tags", "source"],
          "properties": {
            "title": { "type": "string" },
            "description": { "$ref": "#/$defs/nullableString" },
            "timing": { "$ref": "#/$defs/timing" },
            "not_before": { "$ref": "#/$defs/nullableCalendarValue" },
            "deadline": { "$ref": "#/$defs/nullableCalendarValue" },
            "priority": { "type": "integer" },
            "requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["resource_id", "units"],
                "properties": {
                  "resource_id": { "type": "string" },
                  "units": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            },
            "owner": { "$ref": "#/$defs/nullableString" },
            "tags": { "$ref": "#/$defs/stringArray" },
            "source": { "$ref": "#/$defs/nullableString" }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": ["status", "blocked_reason"],
          "properties": {
            "status": { "enum": ["planned", "active", "blocked", "suspended", "done"] },
            "blocked_reason": { "$ref": "#/$defs/nullableString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gateSemantic": {
      "type": "object",
      "required": ["id", "from_milestone_id", "to_milestone_id", "reason"],
      "properties": {
        "id": { "type": "string" },
        "from_milestone_id": { "type": "string" },
        "to_milestone_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resourceSemantic": {
      "type": "object",
      "required": ["id", "title", "description", "capacity", "tags"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "$ref": "#/$defs/nullableString" },
        "capacity": { "type": "integer", "minimum": 1 },
        "tags": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "entitySemantic": {
      "oneOf": [
        { "$ref": "#/$defs/milestoneSemantic" },
        { "$ref": "#/$defs/taskSemantic" },
        { "$ref": "#/$defs/gateSemantic" },
        { "$ref": "#/$defs/resourceSemantic" }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["class", "causes", "semantic_changed", "source_changed", "changed_axes", "is_merge_commit", "canonical_advance"],
      "properties": {
        "class": { "enum": ["initial", "representation_only", "evidence_extension", "lifecycle_projection", "future_plan_edit", "canonical_advance", "ambiguous_edit", "conflict"] },
        "causes": {
          "type": "array",
          "items": { "enum": ["event_payload_changed", "identity_ambiguous", "ambiguous_edit", "noncanonical_removal", "topology_conflict"] }
        },
        "semantic_changed": { "type": "boolean" },
        "source_changed": { "type": "boolean" },
        "changed_axes": {
          "type": "array",
          "items": { "enum": ["planning", "lifecycle", "actual_evidence", "governance", "assurance", "topology"] }
        },
        "is_merge_commit": { "type": "boolean" },
        "canonical_advance": {
          "oneOf": [
            {
              "type": "object",
              "required": ["planner_version", "candidate_semantic_digest"],
              "properties": {
                "planner_version": { "type": "string" },
                "candidate_semantic_digest": { "$ref": "#/$defs/digest" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "required": ["entity_kind", "source_id", "occurrence_id", "value_epoch_ordinal", "semantic", "from_occurrence_id", "to_occurrence_id", "first_observed_commit_id", "last_observed_commit_id", "retired_at_commit_id"],
      "properties": {
        "entity_kind": { "enum": ["milestone", "task", "gate", "resource"] },
        "source_id": { "type": "string" },
        "occurrence_id": { "$ref": "#/$defs/nullableString" },
        "value_epoch_ordinal": { "type": ["integer", "null"], "minimum": 1 },
        "semantic": { "$ref": "#/$defs/entitySemantic" },
        "from_occurrence_id": { "$ref": "#/$defs/nullableString" },
        "to_occurrence_id": { "$ref": "#/$defs/nullableString" },
        "first_observed_commit_id": { "type": "string" },
        "last_observed_commit_id": { "type": "string" },
        "retired_at_commit_id": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "snapshotGraph": {
      "type": "object",
      "required": ["project_id", "semantic_digest", "topology_epoch_id", "occurrences"],
      "properties": {
        "project_id": { "type": "string" },
        "semantic_digest": { "$ref": "#/$defs/digest" },
        "topology_epoch_id": { "$ref": "#/$defs/nullableString" },
        "occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence" } }
      },
      "additionalProperties": false
    },
    "checkpointSummary": {
      "type": "object",
      "required": ["commit_id", "parent_commit_ids", "blob_id", "source_digest", "recorded_at", "is_merge_commit", "segment_ordinal", "assurance", "semantic_digest", "topology_epoch_id", "transition", "occurrence_count", "source_binding_count"],
      "properties": {
        "commit_id": { "type": "string" },
        "parent_commit_ids": { "$ref": "#/$defs/stringArray" },
        "blob_id": { "type": "string" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "recorded_at": { "$ref": "#/$defs/nullableString" },
        "is_merge_commit": { "type": "boolean" },
        "segment_ordinal": { "type": "integer", "minimum": 1 },
        "assurance": { "enum": ["verified", "withheld", "not_enabled", "unavailable"] },
        "semantic_digest": { "$ref": "#/$defs/digest" },
        "topology_epoch_id": { "$ref": "#/$defs/nullableString" },
        "transition": { "$ref": "#/$defs/transition" },
        "occurrence_count": { "type": "integer", "minimum": 0 },
        "source_binding_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["commit_id", "parent_commit_ids", "blob_id", "source_digest", "recorded_at", "is_merge_commit", "segment_ordinal", "assurance", "semantic_digest", "topology_epoch_id", "transition", "occurrence_count", "source_binding_count", "graph"],
      "properties": {
        "commit_id": { "type": "string" },
        "parent_commit_ids": { "$ref": "#/$defs/stringArray" },
        "blob_id": { "type": "string" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "recorded_at": { "$ref": "#/$defs/nullableString" },
        "is_merge_commit": { "type": "boolean" },
        "segment_ordinal": { "type": "integer", "minimum": 1 },
        "assurance": { "enum": ["verified", "withheld", "not_enabled", "unavailable"] },
        "semantic_digest": { "$ref": "#/$defs/digest" },
        "topology_epoch_id": { "$ref": "#/$defs/nullableString" },
        "transition": { "$ref": "#/$defs/transition" },
        "occurrence_count": { "type": "integer", "minimum": 0 },
        "source_binding_count": { "type": "integer", "minimum": 0 },
        "graph": { "$ref": "#/$defs/snapshotGraph" }
      },
      "additionalProperties": false
    },
    "workEvent": {
      "type": "object",
      "required": ["id", "model", "task_id", "kind", "occurred_at", "planned_value", "active_time", "effort", "reason"],
      "properties": {
        "id": { "type": "string" },
        "model": { "const": 1 },
        "task_id": { "type": "string" },
        "kind": { "enum": ["start", "suspend", "resume", "finish"] },
        "occurred_at": { "$ref": "#/$defs/calendarValue" },
        "planned_value": { "oneOf": [{ "$ref": "#/$defs/exactValue" }, { "type": "null" }] },
        "active_time": { "oneOf": [{ "$ref": "#/$defs/exactValue" }, { "type": "null" }] },
        "effort": { "oneOf": [{ "$ref": "#/$defs/exactValue" }, { "type": "null" }] },
        "reason": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["project_id", "endpoint_checkpoint_id", "occurrences", "current_occurrence_ids", "retired_occurrence_ids", "frozen_work_events", "canonical_advance_proofs"],
      "properties": {
        "project_id": { "type": "string" },
        "endpoint_checkpoint_id": { "type": "string" },
        "occurrences": { "type": "array", "items": { "$ref": "#/$defs/occurrence" } },
        "current_occurrence_ids": { "$ref": "#/$defs/stringArray" },
        "retired_occurrence_ids": { "$ref": "#/$defs/stringArray" },
        "frozen_work_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "task_occurrence_id", "first_observed_commit_id", "last_observed_commit_id", "event"],
            "properties": {
              "id": { "type": "string" },
              "task_occurrence_id": { "type": "string" },
              "first_observed_commit_id": { "type": "string" },
              "last_observed_commit_id": { "type": "string" },
              "event": { "$ref": "#/$defs/workEvent" }
            },
            "additionalProperties": false
          }
        },
        "canonical_advance_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_commit_id", "to_commit_id", "from_blob_id", "to_blob_id", "from_source_digest", "to_source_digest", "planner_version", "candidate_semantic_digest", "removed_occurrence_ids", "retained_occurrence_ids", "removed_task_ids", "removed_gate_ids", "removed_milestone_ids", "removed_work_event_ids", "removed_assurance_record_ids", "state_changed_milestone_ids"],
            "properties": {
              "from_commit_id": { "type": "string" },
              "to_commit_id": { "type": "string" },
              "from_blob_id": { "type": "string" },
              "to_blob_id": { "type": "string" },
              "from_source_digest": { "$ref": "#/$defs/digest" },
              "to_source_digest": { "$ref": "#/$defs/digest" },
              "planner_version": { "type": "string" },
              "candidate_semantic_digest": { "$ref": "#/$defs/digest" },
              "removed_occurrence_ids": { "$ref": "#/$defs/stringArray" },
              "retained_occurrence_ids": { "$ref": "#/$defs/stringArray" },
              "removed_task_ids": { "$ref": "#/$defs/stringArray" },
              "removed_gate_ids": { "$ref": "#/$defs/stringArray" },
              "removed_milestone_ids": { "$ref": "#/$defs/stringArray" },
              "removed_work_event_ids": { "$ref": "#/$defs/stringArray" },
              "removed_assurance_record_ids": { "$ref": "#/$defs/stringArray" },
              "state_changed_milestone_ids": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["entries", "segments"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["commit_id", "parent_commit_ids", "blob_id", "source_digest", "recorded_at", "is_merge_commit", "validity", "assurance", "segment_ordinal", "semantic_digest", "topology_epoch_id", "transition", "graph", "diagnostic_codes"],
            "properties": {
              "commit_id": { "type": "string" },
              "parent_commit_ids": { "$ref": "#/$defs/stringArray" },
              "blob_id": { "$ref": "#/$defs/nullableString" },
              "source_digest": { "$ref": "#/$defs/nullableDigest" },
              "recorded_at": { "$ref": "#/$defs/nullableString" },
              "is_merge_commit": { "type": "boolean" },
              "validity": { "enum": ["source_missing", "source_invalid", "grammar_unsupported", "syntax_invalid", "semantic_invalid", "semantic_valid"] },
              "assurance": { "enum": ["verified", "withheld", "not_enabled", "unavailable"] },
              "segment_ordinal": { "type": ["integer", "null"], "minimum": 1 },
              "semantic_digest": { "$ref": "#/$defs/nullableDigest" },
              "topology_epoch_id": { "$ref": "#/$defs/nullableString" },
              "transition": { "oneOf": [{ "$ref": "#/$defs/transition" }, { "type": "null" }] },
              "graph": { "oneOf": [{ "$ref": "#/$defs/snapshotGraph" }, { "type": "null" }] },
              "diagnostic_codes": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ordinal", "first_commit_id", "last_commit_id", "checkpoint_commit_ids"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "first_commit_id": { "type": "string" },
              "last_commit_id": { "type": "string" },
              "checkpoint_commit_ids": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sourceBinding": {
      "type": "object",
      "required": ["repository_id", "repository_relative_path", "commit_id", "blob_id", "source_digest", "range", "declaration_kind", "source_id", "owner_path"],
      "properties": {
        "repository_id": { "type": "string" },
        "repository_relative_path": { "type": "string" },
        "commit_id": { "type": "string" },
        "blob_id": { "type": "string" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "range": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/position" },
            "end": { "$ref": "#/$defs/position" }
          },
          "additionalProperties": false
        },
        "declaration_kind": { "type": "string" },
        "source_id": { "type": "string" },
        "owner_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "historicalMilestoneAcceptanceRecord": {
      "type": "object",
      "required": ["kind", "id", "owner_id", "revision_id", "action", "commitment", "source_range"],
      "properties": {
        "kind": { "enum": ["milestone_criterion_set", "milestone_acceptance_receipt", "milestone_acceptance_migration"] },
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "revision_id": { "$ref": "#/$defs/nullableString" },
        "action": { "type": ["string", "null"], "enum": ["verify", "fail", "unavailable", "revoke", "waive", null] },
        "commitment": { "$ref": "#/$defs/nullableDigest" },
        "source_range": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/position" },
            "end": { "$ref": "#/$defs/position" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "historicalMilestoneAcceptance": {
      "type": "object",
      "required": ["model", "model_version", "status", "checkpoints", "canonical_advance_proofs", "causes", "limits"],
      "properties": {
        "model": { "const": "Perttool.HistoricalMilestoneAcceptanceModel.v1" },
        "model_version": { "const": 1 },
        "status": { "enum": ["complete", "incomplete", "unavailable"] },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["commit_id", "blob_id", "source_digest", "grammar_version", "status", "evaluation", "records", "diagnostic_codes"],
            "properties": {
              "commit_id": { "type": "string" },
              "blob_id": { "$ref": "#/$defs/nullableString" },
              "source_digest": { "$ref": "#/$defs/nullableDigest" },
              "grammar_version": { "type": ["integer", "null"], "minimum": 1 },
              "status": { "enum": ["not_applicable", "available", "unavailable"] },
              "evaluation": {
                "oneOf": [
                  { "$ref": "Perttool.MilestoneAcceptanceResult.v1.schema.json#/$defs/acceptanceModel" },
                  { "type": "null" }
                ]
              },
              "records": { "type": "array", "items": { "$ref": "#/$defs/historicalMilestoneAcceptanceRecord" } },
              "diagnostic_codes": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        },
        "canonical_advance_proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_commit_id", "to_commit_id", "planner_version", "candidate_digest", "affected_milestone_ids", "grandfathered_milestone_ids", "accepted_milestone_ids", "removed_record_ids"],
            "properties": {
              "from_commit_id": { "type": "string" },
              "to_commit_id": { "type": "string" },
              "planner_version": { "const": "perttool.milestone-acceptance-advance.v1" },
              "candidate_digest": { "$ref": "#/$defs/digest" },
              "affected_milestone_ids": { "$ref": "#/$defs/stringArray" },
              "grandfathered_milestone_ids": { "$ref": "#/$defs/stringArray" },
              "accepted_milestone_ids": { "$ref": "#/$defs/stringArray" },
              "removed_record_ids": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cause", "commit_id", "record_id", "limit", "actual"],
            "properties": {
              "cause": { "enum": ["evidence_binding_invalid", "source_missing", "source_invalid", "grammar_unsupported", "migration_missing", "migration_baseline_unavailable", "migration_provenance_mismatch", "contract_regression", "acceptance_bypassed", "hard_limit"] },
              "commit_id": { "$ref": "#/$defs/nullableString" },
              "record_id": { "$ref": "#/$defs/nullableString" },
              "limit": { "type": ["string", "null"], "enum": ["checkpoints", "records", null] },
              "actual": { "type": ["integer", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "limits": {
          "type": "object",
          "required": ["checkpoints", "records"],
          "properties": {
            "checkpoints": { "const": 2048 },
            "records": { "const": 100000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": ["offset", "line", "column"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
