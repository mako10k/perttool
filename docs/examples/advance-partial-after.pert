project ADVANCE_PARTIAL:
  version 1
  title "After partial-join advance"
  duration_unit day
  finish RELEASED

milestone NOW:
  title "Now"
  state reached

milestone A_DONE:
  title "A-side prior work complete"
  state reached

milestone JOINED:
  title "A/B join"

milestone RELEASED:
  title "Released"

task A_JOIN_WORK A_DONE -> JOINED:
  title "A-side join work"
  duration 1d
  status done

task BRANCH_B NOW -> JOINED:
  title "B-side work"
  duration 3d
  status active

task RELEASE JOINED -> RELEASED:
  title "Release"
  duration 1d
