project PARALLEL:
  version 1
  title "Parallel plan with shared resources"
  description |
    An example where resource capacity changes the actual start order
    and schedule critical path even when dependencies permit concurrency.
  as_of 2026-07-21
  duration_unit day
  finish RELEASED

resource DEVELOPERS:
  title "Developer slots"
  capacity 2

resource TEST_ENV:
  title "Shared test environment"
  description "Only one task can use it at a time"
  capacity 1

milestone NOW:
  title "Now"
  state reached

milestone CORE_DONE:
  title "Core implementation complete"

milestone CLI_DONE:
  title "CLI implementation complete"

milestone DOCS_DONE:
  title "Documentation complete"

milestone INTEGRATION_READY:
  title "Integration ready"

milestone TEST_DONE:
  title "Testing complete"

milestone PACKAGE_DONE:
  title "Package complete"

milestone RELEASED:
  title "Released"

task CORE NOW -> CORE_DONE:
  title "Implement core"
  duration 4d
  priority 20
  requires:
    DEVELOPERS 1

task CLI NOW -> CLI_DONE:
  title "Implement CLI"
  duration 3d
  priority 10
  requires:
    DEVELOPERS 1

task DOCS NOW -> DOCS_DONE:
  title "Write user documentation"
  duration 2d
  requires:
    DEVELOPERS 1

gate CORE_READY CORE_DONE -> INTEGRATION_READY:
  reason "Integration requires the core"

gate CLI_READY CLI_DONE -> INTEGRATION_READY:
  reason "Integration requires the CLI"

gate DOCS_READY DOCS_DONE -> INTEGRATION_READY:
  reason "Release requires documentation"

task TEST INTEGRATION_READY -> TEST_DONE:
  title "Test in the shared environment"
  duration 2d
  priority 10
  requires:
    TEST_ENV 1

task PACKAGE INTEGRATION_READY -> PACKAGE_DONE:
  title "Build a package in the shared environment"
  duration 1d
  requires:
    TEST_ENV 1

gate TEST_RELEASE_GATE TEST_DONE -> RELEASED:
  reason "Testing must be complete"

gate PACKAGE_RELEASE_GATE PACKAGE_DONE -> RELEASED:
  reason "Packaging must be complete"
