project POINT_VELOCITY:
  version 1
  title "Point estimates and velocity forecasts"
  description |
    Estimate relative size in Points and obtain day forecasts with velocity 20p/10d.
    Retain the baseline values for PERT/CPM and the resource schedule in Points.
  duration_unit point
  velocity 20p/10d
  finish RELEASED

resource DEVELOPERS:
  title "Developer slots"
  capacity 1

milestone NOW:
  title "Now"
  state reached

milestone DESIGNED:
  title "Design complete"

milestone IMPLEMENTED:
  title "Implementation complete"

milestone RELEASED:
  title "Released"

task DESIGN NOW -> DESIGNED:
  title "Design"
  estimate:
    optimistic 3p
    most_likely 5p
    pessimistic 7p
  priority 10
  requires:
    DEVELOPERS 1

task IMPLEMENT NOW -> IMPLEMENTED:
  title "Implement"
  duration 10p
  priority 20
  requires:
    DEVELOPERS 1

gate DESIGN_RELEASE DESIGNED -> RELEASED:
  reason "Design must be complete"

gate IMPLEMENT_RELEASE IMPLEMENTED -> RELEASED:
  reason "Implementation must be complete"
